---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Investments from '../components/Investments.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main class="stack">
    <Hero />
    <Projects />
    <WhyChooseUs />
    <Investments />
    <About />
    <Team />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Base>

<style is:global>
  /* ---- Scroll "folding" stack ----
     Each section overlaps the previous with a rounded top + shadow (the card
     look), and — on browsers with scroll-driven animations — physically
     RECEDES (scales down + sinks) as the next section slides up over it, so it
     feels like a deck of cards folding together while you scroll. No sticky
     pinning, so tall sections (Projects/FAQ) never freeze or hide content. */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    .stack > section {
      position: relative;
      background-clip: padding-box;
    }
    .stack > section + section {
      margin-top: -64px;
      border-top-left-radius: 42px;
      border-top-right-radius: 42px;
      box-shadow: 0 -16px 44px rgba(10, 10, 10, 0.15);
    }
    /* later panels stack above earlier ones so the fold direction is correct */
    .stack > .hero { z-index: 1; }
    .stack > .projects { z-index: 2; }
    .stack > .why { z-index: 3; }
    .stack > .inv { z-index: 4; }
    .stack > .about { z-index: 5; }
    .stack > .team { z-index: 6; }
    .stack > .faq { z-index: 7; }
    .stack > .contact { z-index: 8; }
  }

  /* The motion: sections recede as they exit the top (get covered). */
  @supports (animation-timeline: view()) {
    @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
      .stack > section {
        transform-origin: 50% 0%;
        animation: stackRecede linear both;
        animation-timeline: view();
        /* animate over the last stretch of the section's time on screen,
           i.e. while the following section is sliding up over it */
        animation-range: cover 55% cover 100%;
      }
      /* last section shouldn't shrink under the footer */
      .stack > .contact { animation: none; }
    }
  }
  @keyframes stackRecede {
    to { transform: scale(0.9) translateY(-24px); filter: brightness(0.86); }
  }
</style>
