---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Investments from '../components/Investments.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main>
    <Hero />
    <div class="after-hero">
      <Projects />
      <WhyChooseUs />
      <Investments />
      <About />
      <Team />
      <Faq />
      <Contact />
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  /* Hero "провалювання" (pinned scrub):
     The hero is pinned (sticky). Everything after it lives in one opaque layer
     (.after-hero) that scrolls up and covers the hero — so there are never any
     gaps between sections. While it's being covered, the hero sinks, shrinks and
     tilts back in 3D (driven by JS below), so the first screen appears to fall
     into the next block, exactly like the original. */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    /* The fold is applied to the video panel itself; it folds onto the light
       first-screen background (see Hero.astro) with no covering layer, so the
       panel's rounded bottom corners stay visible — like the original. */
    .hero__panel {
      transform-origin: 50% 100%;
      will-change: transform;
      backface-visibility: hidden;
    }
  }
</style>

<script is:inline>
  /* Hero "book fold" — exact scroll-linked transform measured on the live original
     (framer-vyoek): over ~0.66 viewport of scroll the First screen sinks, shrinks
     and folds back on the X axis:
        translateY 0 → 180px,  scale 1 → 0.95,  rotateX 0 → -50deg
        (origin 50% 50%, linear, no easing)
     Verified against the original at scroll 150/300/600 (matrix3d matches within 1%).
     Applied to the video panel, which folds onto the light first-screen area
     below it (no covering layer). Pure JS → works in every browser. */
  (() => {
    const mq = window.matchMedia('(min-width: 861px)');
    const hero = document.querySelector('.hero__panel');
    if (!hero) return;
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!mq.matches) { hero.style.transform = ''; return; }
      const CAP = window.innerHeight * 0.66; // fold completes over ~0.66 viewport of scroll
      let p = window.scrollY / CAP;
      p = p < 0 ? 0 : p > 1 ? 1 : p;
      // Fold pivots around the panel's BOTTOM edge (transform-origin 50% 100%), so
      // the bottom keeps tracking normal scroll while the top recedes — this keeps
      // the gap to the next block constant (like the original) instead of the panel
      // racing away and opening a white void. No translateY needed.
      const sc = (1 - 0.05 * p).toFixed(4);
      const rx = (-50 * p).toFixed(2);
      hero.style.transform = 'scale(' + sc + ') rotateX(' + rx + 'deg)';
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>
