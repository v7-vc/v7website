---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Investments from '../components/Investments.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main>
    <Hero />
    <div class="after-hero">
      <Projects />
      <WhyChooseUs />
      <Investments />
      <About />
      <Team />
      <Faq />
      <Contact />
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  /* Hero "провалювання" (pinned scrub):
     The hero is pinned (sticky). Everything after it lives in one opaque layer
     (.after-hero) that scrolls up and covers the hero — so there are never any
     gaps between sections. While it's being covered, the hero sinks, shrinks and
     tilts back in 3D (driven by JS below), so the first screen appears to fall
     into the next block, exactly like the original. */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    main > .hero {
      position: sticky;
      top: 0;
      z-index: 0;
      transform-origin: 50% 34%;
      will-change: transform, opacity;
    }
    main > .after-hero {
      position: relative;
      z-index: 1;
      background: var(--surface);
    }
  }
</style>

<script is:inline>
  (() => {
    const mq = window.matchMedia('(min-width: 861px)');
    const hero = document.querySelector('main > .hero');
    if (!hero) return;
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!mq.matches) { hero.style.transform = ''; hero.style.opacity = ''; return; }
      const h = hero.offsetHeight || window.innerHeight;
      let p = window.scrollY / (h * 0.9);
      p = p < 0 ? 0 : p > 1 ? 1 : p;
      // Subtle 3D recede only — the video stays fully opaque (NO fade, so it
      // never washes into light), and the opaque block below covers it as it
      // scrolls up.
      hero.style.transform =
        'perspective(2000px) ' +
        'scale(' + (1 - 0.045 * p).toFixed(4) + ') ' +
        'rotateX(' + (p * 6).toFixed(2) + 'deg)';
      hero.style.opacity = '';
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>
