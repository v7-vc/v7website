---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Investments from '../components/Investments.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main>
    <Hero />
    <Projects />
    <WhyChooseUs />
    <Investments />
    <About />
    <Team />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Base>

<style is:global>
  /* Hero-only scroll effect: the video panel stays pinned while the rest of the
     page scrolls up and covers it — so the "fold" happens only while you scroll
     through the hero, with no gaps (the covering sections are opaque). */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    main > .hero {
      position: sticky;
      top: 0;
      z-index: 0;
    }
    main > .projects,
    main > .why,
    main > .inv,
    main > .about,
    main > .team,
    main > .faq,
    main > .contact {
      position: relative;
      z-index: 1;
    }
  }
</style>
