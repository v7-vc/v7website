---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Investments from '../components/Investments.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main>
    <Hero />
    <div class="after-hero">
      <Projects />
      <WhyChooseUs />
      <Investments />
      <About />
      <Team />
      <Faq />
      <Contact />
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  /* Hero "провалювання" (pinned scrub):
     The hero is pinned (sticky). Everything after it lives in one opaque layer
     (.after-hero) that scrolls up and covers the hero — so there are never any
     gaps between sections. While it's being covered, the hero sinks, shrinks and
     tilts back in 3D (driven by JS below), so the first screen appears to fall
     into the next block, exactly like the original. */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    main > .hero {
      position: relative;
      z-index: 0;
      transform-origin: 50% 55%;
      will-change: transform;
      backface-visibility: hidden;
    }
    main > .after-hero {
      position: relative;
      z-index: 1;
      background: var(--surface);
    }
  }
</style>

<script is:inline>
  /* Hero "book fold" — replicates the original's scroll-linked First-screen
     transform (measured on v7.vc): the whole hero tilts back on the X axis
     (rotateX → ~48.5°), sinks (translateY → ~180px) and narrows (scaleX → 0.95)
     over the first ~600px of scroll, while the opaque block below rises to cover
     it. Video stays fully opaque (no fade). Pure JS → works in every browser. */
  (() => {
    const mq = window.matchMedia('(min-width: 861px)');
    const hero = document.querySelector('main > .hero');
    if (!hero) return;
    const CAP = 600;               // scroll distance over which the fold completes
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!mq.matches) { hero.style.transform = ''; return; }
      let p = window.scrollY / CAP;
      p = p < 0 ? 0 : p > 1 ? 1 : p;
      const rotateX = (48.5 * p).toFixed(2);
      const ty = (180 * p).toFixed(1);
      const sx = (1 - 0.05 * p).toFixed(4);
      hero.style.transform =
        'perspective(9000px) translateY(' + ty + 'px) rotateX(' + rotateX + 'deg) scaleX(' + sx + ')';
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>
