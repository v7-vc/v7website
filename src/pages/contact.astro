---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const ZAP = 'https://hooks.zapier.com/hooks/catch/24172971/u6x858o/';
---
<Base title="V7 – Contact" description="Have a project in mind? Reach out to us, and we’ll discuss the best way to move forward.">
  <Header />
  <main>
    <section class="git">
      <div class="container">
        <h1 class="git__title" data-reveal>Get in touch.</h1>

        <div class="git__grid">
          <p class="git__lead" data-reveal>
            <span class="git__ink">Have a project in mind?</span>
            <span class="git__muted"> Reach out to us, and we’ll discuss the best way to move forward.</span>
          </p>

          <form class="gform" action={ZAP} method="post" data-reveal>
            <div class="gfield">
              <input id="g-name" name="name" type="text" placeholder="Your name *" required autocomplete="name" />
            </div>
            <div class="gfield">
              <input id="g-email" name="email" type="email" placeholder="Email *" required autocomplete="email" />
            </div>
            <div class="gfield gfield--area">
              <textarea id="g-message" name="message" rows="4" placeholder="Your message"></textarea>
            </div>

            <label class="gupload">
              <input type="file" name="presentation" accept=".pdf,.ppt,.pptx,.key,.doc,.docx" hidden />
              <span class="gupload__plus" aria-hidden="true">+</span>
              <span class="gupload__text">Upload your presentation</span>
              <span class="gupload__file" data-file-name></span>
            </label>

            <button type="submit" class="gform__submit">
              <span>Submit</span>
              <span class="gform__dot" aria-hidden="true"></span>
            </button>
            <p class="gform__status" data-form-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script is:inline>
  (() => {
    const form = document.querySelector('.gform');
    if (!form) return;
    const status = form.querySelector('[data-form-status]');
    const btn = form.querySelector('.gform__submit');
    const btnText = btn.querySelector('span:first-child') || btn;
    const file = form.querySelector('input[type="file"]');
    const fileName = form.querySelector('[data-file-name]');
    if (file) file.addEventListener('change', () => {
      fileName.textContent = file.files?.[0] ? file.files[0].name : '';
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      btn.disabled = true;
      const orig = btnText.textContent;
      btnText.textContent = 'Sending…';
      try {
        await fetch(form.action, { method: 'POST', mode: 'no-cors', body: data });
        form.reset();
        fileName.textContent = '';
        status.textContent = 'Thanks — we’ll be in touch soon.';
      } catch {
        status.textContent = 'Something went wrong. Email hello@v7.vc instead.';
      } finally {
        btn.disabled = false;
        btnText.textContent = orig;
      }
    });
  })();
</script>

<style>
  .git {
    background: var(--surface);
    padding-block: clamp(90px, 13vw, 180px) clamp(64px, 9vw, 120px);
  }
  .git__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(3.4rem, 10.28vw, 9.25rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    color: var(--ink);
  }
  /* two-column: lead on the left, form on the right (matches original) */
  .git__grid {
    margin-top: clamp(48px, 7vw, 96px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .git__lead {
    margin: 0;
    max-width: 26ch;
    text-align: left;
    font-family: var(--font-display-curved);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .git__ink { color: var(--ink); }
  .git__muted { color: rgba(10, 10, 10, 0.6); }

  .gform {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .gfield input, .gfield textarea {
    width: 100%;
    padding: 26px 8px;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(10, 10, 10, 0.15);
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--ink);
    resize: vertical;
  }
  .gfield input::placeholder, .gfield textarea::placeholder { color: #999999; }
  .gfield input:focus, .gfield textarea:focus { outline: none; border-bottom-color: var(--ink); }
  .gfield--area textarea { min-height: 170px; }

  .gupload {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 26px 8px;
    cursor: pointer;
    border-bottom: 1px solid rgba(10, 10, 10, 0.15);
  }
  .gupload__plus {
    display: inline-grid;
    place-items: center;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1.2rem;
    line-height: 1;
  }
  .gupload__text {
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .gupload__file { font-size: 0.95rem; color: #9b9b9b; }
  .gupload:hover .gupload__plus { filter: brightness(1.06); }

  .gform__submit {
    align-self: flex-start;
    margin-top: clamp(32px, 5vw, 48px);
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding: 16px 16px 16px 34px;
    border-radius: 50px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    transition: transform 0.3s var(--ease-out), filter 0.3s var(--ease-out);
  }
  .gform__dot {
    width: 24px; height: 24px;
    border-radius: 50%;
    background: #fff;
    flex: none;
  }
  .gform__submit:hover { transform: translateY(-2px); filter: brightness(1.06); }
  .gform__submit:disabled { opacity: 0.6; }
  .gform__status:empty { display: none; }
  .gform__status { margin-top: 14px; font-size: 0.95rem; color: var(--ink); }

  @media (max-width: 860px) {
    .git__grid { grid-template-columns: 1fr; gap: clamp(32px, 6vw, 48px); }
    .git__lead { max-width: 34ch; }
  }
</style>
