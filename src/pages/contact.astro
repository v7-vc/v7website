---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const ZAP = 'https://hooks.zapier.com/hooks/catch/24172971/u6x858o/';
---
<Base title="V7 – Contact" description="Have a project in mind? Reach out to us, and we’ll discuss the best way to move forward.">
  <Header />
  <main>
    <section class="git">
      <div class="container">
        <h1 class="git__title" data-reveal>Get in touch.</h1>

        <div class="git__grid">
          <div class="git__col-lead">
            <p class="git__lead" data-reveal>
              <span class="git__ink">Have a project in mind?</span>
              <span class="git__muted"> Reach out to us, and we’ll discuss the best way to move forward.</span>
            </p>
          </div>

          <div class="git__col-form">
          <form class="gform" action={ZAP} method="post" data-reveal>
            <div class="gfield">
              <label class="gfield__label" for="g-name">Your name *</label>
              <input id="g-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="gdivider"></div>
            <div class="gfield">
              <label class="gfield__label" for="g-email">Email *</label>
              <input id="g-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="gdivider"></div>
            <div class="gfield gfield--area">
              <label class="gfield__label" for="g-message">Your message</label>
              <textarea id="g-message" name="message" rows="5"></textarea>
            </div>
            <div class="gdivider"></div>

            <label class="gupload">
              <input type="file" name="presentation" accept=".pdf,.ppt,.pptx,.key" hidden />
              <span class="gupload__plus" aria-hidden="true">+</span>
              <span class="gupload__text">Upload your presentation</span>
              <span class="gupload__file" data-file-name></span>
            </label>

            <div class="gform__actions">
              <button type="submit" class="gform__submit">
                <span>Submit</span>
              </button>
            </div>
            <p class="gform__status" data-form-status role="status" aria-live="polite"></p>
          </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script is:inline>
  (() => {
    const form = document.querySelector('.gform');
    if (!form) return;
    const status = form.querySelector('[data-form-status]');
    const btn = form.querySelector('.gform__submit');
    const btnText = btn.querySelector('span:first-child') || btn;
    const file = form.querySelector('input[type="file"]');
    const fileName = form.querySelector('[data-file-name]');
    if (file) file.addEventListener('change', () => {
      fileName.textContent = file.files?.[0] ? file.files[0].name : '';
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      btn.disabled = true;
      const orig = btnText.textContent;
      btnText.textContent = 'Sending…';
      try {
        await fetch(form.action, { method: 'POST', mode: 'no-cors', body: data });
        form.reset();
        fileName.textContent = '';
        status.textContent = 'Thanks — we’ll be in touch soon.';
      } catch {
        status.textContent = 'Something went wrong. Email hello@v7.vc instead.';
      } finally {
        btn.disabled = false;
        btnText.textContent = orig;
      }
    });
  })();
</script>

<style>
  .git {
    background: var(--surface);
    padding-block: clamp(90px, 19.3vw, 278px) clamp(64px, 9vw, 120px);
  }
  .git__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(4rem, 10.28vw, 9.25rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    color: var(--ink);
  }
  /* two-column: lead on the left, form on the right (matches original) */
  .git__grid {
    margin-top: 221px;
    display: flex;
    flex-flow: row;
    align-items: flex-start;
    gap: 10px;
  }
  .git__col-lead { flex: 1 0 0; padding-right: 80px; min-width: 0; }
  .git__col-form { flex: 1 0 0; min-width: 0; }
  .git__lead {
    margin: 0;
    /* Original block is 550px wide; our Marund Curved renders narrower, so we
       reduce max-width to reproduce the original's line-1 break ("…Reach"). */
    max-width: 435px;
    text-align: left;
    font-family: var(--font-display-curved);
    font-size: 2rem;         /* 32px */
    line-height: 1.2;        /* 38.4px */
    letter-spacing: -0.04em; /* -1.28px */
    color: rgba(10, 10, 10, 0.6);
  }
  .git__ink { color: var(--ink); }
  .git__muted { color: rgba(10, 10, 10, 0.6); }

  /* form is a self-contained grey card, 519px wide (matches original iframe widget) */
  .gform {
    margin: 0;
    width: 519px;
    max-width: 100%;
    box-sizing: border-box;
    background: #f6f6f6;
    border-radius: 8px;
    padding: 20px 20px 16px;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display-curved);
  }
  .gfield { display: flex; flex-direction: column; gap: 8px; }
  .gfield__label { color: #8a8a8a; font-size: 14px; line-height: 1.2; }
  .gfield input, .gfield textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 6px 0;
    background: transparent;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 16px;
    line-height: 1.3;
    color: #000;
    resize: vertical;
  }
  .gfield--area textarea { min-height: 96px; }

  .gdivider {
    height: 1px;
    width: 100%;
    background: #e2e2e2;
    margin: 6px 0 14px;
  }

  .gupload {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 0;
    cursor: pointer;
    color: #111;
    font-size: 16px;
  }
  .gupload__plus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
    transition: transform 0.15s ease;
  }
  .gupload__text {
    font-family: var(--font-display-curved);
    font-size: 16px;
    line-height: 1.2;
    color: #111;
  }
  .gupload__file { font-size: 0.85rem; color: #9b9b9b; }
  .gupload:active .gupload__plus { transform: scale(0.95); }

  .gform__actions { margin-top: 16px; display: flex; align-items: center; gap: 12px; }
  .gform__submit {
    position: relative;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 12px 56px 12px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    transition: filter 0.15s ease;
  }
  .gform__submit::after {
    content: "";
    position: absolute;
    right: 14px; top: 50%;
    transform: translateY(-50%);
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.9;
  }
  .gform__submit:hover { filter: brightness(1.04); }
  .gform__submit:disabled { opacity: 0.85; cursor: not-allowed; }
  .gform__status:empty { display: none; }
  .gform__status { margin-top: 14px; font-size: 0.9rem; color: var(--ink); }

  @media (max-width: 809px) {
    .git__grid { flex-direction: column; gap: 40px; margin-top: 24px; }
    .git__col-lead { padding-right: 0; }
    .git__lead {
      max-width: none;
      font-size: 1.25rem;    /* 20px — matches original mobile */
      line-height: 1.2;
    }
    .gform { width: 100%; }
  }
</style>
