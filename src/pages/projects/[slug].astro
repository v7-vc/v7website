---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
// Original shows the first 5 projects in the catalog order, with the current one removed.
const next = projects.filter((p) => p.slug !== project.slug).slice(0, 5);
---
<Base title={`V7 – ${project.name}`} description={project.tagline}>
  <Header />
  <main>
    <section class="pj">
      <div class="container">
        <h1 class="pj__title" data-reveal>{project.name}</h1>

        <div class="pj__row pj__row--intro" data-reveal>
          <span class="pj__label"><span class="pj__plus" aria-hidden="true">+</span> Introduction</span>
          <p class="pj__tagline">{project.tagline}</p>
        </div>

        <hr class="pj__divider" data-reveal />

        <div class="pj__row pj__row--industry" data-reveal>
          <span class="pj__spacer" aria-hidden="true"></span>
          <div class="pj__industryRow">
            <span class="pj__label pj__label--plain">Industry</span>
            <p class="pj__industry">{project.industry}</p>
          </div>
        </div>

        {project.logo && (
          <div class="pj__row pj__row--logo" data-reveal>
            <span class="pj__spacer" aria-hidden="true"></span>
            <img class="pj__logo" src={project.logo} alt={project.name} loading="eager" />
          </div>
        )}

        <div class="pj__row pj__row--about" data-reveal>
          <span class="pj__label"><span class="pj__plus" aria-hidden="true">+</span> About</span>
          <div class="pj__aboutCol">
            <p class="pj__about">{project.about}</p>
            {project.url && (
              <a class="pj__site" href={project.url} target="_blank" rel="noopener noreferrer">
                <span class="btnswap btnswap--sm">
                  <span class="btnswap__rest">Website</span>
                  <span class="btnswap__hover" aria-hidden="true">Website</span>
                </span>
                <span class="pj__dot" aria-hidden="true"></span>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="pjnext">
      <div class="container">
        <div class="pjnext__head" data-reveal>
          <h2 class="pjnext__title">Next projects.</h2>
          <a class="pjnext__all" href="/projects">
            <span class="btnswap btnswap--sm">
              <span class="btnswap__rest">All projects</span>
              <span class="btnswap__hover" aria-hidden="true">All projects</span>
            </span>
            <span class="pjnext__dot" aria-hidden="true"></span>
          </a>
        </div>
        <ul class="pjnext__grid" data-reveal-group="">
          {next.map((p) => (
            <li class="project" data-reveal-child>
              <a class="project__link" href={`/projects/${p.slug}`}>
                <span class="project__pill">{p.name}</span>
                <span class="project__tile">
                  <img src={p.card} alt={`${p.name} — ${p.category}`} loading="lazy" width="1060" height="772" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Base>

<style>
  .pj {
    background: var(--surface);
    padding-block: clamp(96px, 19.3vw, 278px) clamp(48px, 6vw, 90px);
  }
  /* Original desktop: H1 top sits at a fixed 340px (278 + the 62px header) */
  @media (min-width: 1200px) {
    .pj { padding-top: 278px; }
  }
  .pj__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(4rem, 12.33vw, 9.25rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-bottom: clamp(60px, 8.3vw, 120px);
  }
  /* Original desktop gaps (measured live, fixed px): H1→intro 120, tagline→
     divider 100, divider→Industry 23, Industry→About 321 */
  @media (min-width: 1200px) {
    .pj__title { margin-bottom: 120px; }
  }
  .pj__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    align-items: start;
  }
  .pj__divider {
    border: none;
    border-top: 1px solid rgb(226, 226, 226); /* exact from the Framer project */
    margin: clamp(48px, 6.9vw, 100px) 0 0;
  }
  .pj__row--industry { margin-top: 23px; }
  /* Original right column order: logo (its own row) → About row → Website button.
     Measured identical on zeely and elephants: Industry text bottom → logo 87px,
     logo bottom → About 180px. */
  .pj__row--logo { margin-top: clamp(48px, 6.7vw, 87px); }
  .pj__row--about { margin-top: clamp(80px, 13.8vw, 180px); }
  @media (min-width: 1200px) {
    .pj__divider { margin-top: 100px; }
    .pj__row--logo { margin-top: 87px; }
    .pj__row--about { margin-top: 180px; }
    /* Website button bottom → "Next projects." is 180px in the original */
    .pj { padding-bottom: 90px; }
    .pjnext { padding-top: 90px; }
  }

  .pj__label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pj__plus {
    display: inline-grid;
    place-items: center;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem; line-height: 1;
    font-family: var(--font-body);
    flex: none;
  }
  /* Industry row: label sits in the right column, value pushed to the far right */
  .pj__industryRow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }
  /* Framer: the "Industry" label renders at 50% opacity (rgb(9,9,9) × 0.5) */
  .pj__label--plain { opacity: 0.5; }
  .pj__tagline, .pj__industry {
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pj__tagline { max-width: 630px; }
  .pj__industry { font-size: 1.125rem; line-height: 1.4; }

  /* about text → Website button gap is a fixed 100px in the original */
  .pj__aboutCol { display: flex; flex-direction: column; gap: clamp(40px, 7.6vw, 100px); }
  /* original: a fixed 114×54 logo frame, artwork contained inside */
  .pj__logo { width: 114px; height: 54px; object-fit: contain; object-position: left center; align-self: flex-start; }
  .pj__about {
    font-family: var(--font-display-curved);
    font-size: clamp(1.5rem, 3.95vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pj__site {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 34px;
    height: 40px;
    padding: 9px 11px 9px 21px;
    border-radius: 50px;
    background: var(--accent);
    color: #fff;
    transition: transform 0.3s var(--ease-out), filter 0.3s var(--ease-out);
  }
  .pj__site:hover { transform: translateY(-2px); filter: brightness(1.06); }
  .pj__dot { width: 8px; height: 8px; border-radius: 50%; background: #fff; flex: none; }

  /* ---- next projects ---- */
  .pjnext { background: var(--surface); padding-block: clamp(48px, 7vw, 100px) clamp(6px, 1vw, 10px); }
  .pjnext__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .pjnext__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 3.875rem; /* fixed 62px like the original */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: var(--ink);
  }
  .pjnext__all {
    display: inline-flex;
    align-items: center;
    gap: 34px;
    height: 40px;
    padding: 9px 11px 9px 21px;
    border-radius: 50px;
    background: var(--accent);
    color: #fff;
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }
  .pjnext__dot { width: 8px; height: 8px; border-radius: 50%; background: #fff; flex: none; }
  .pjnext__all:hover { transform: translateY(-2px); opacity: 0.9; }

  .pjnext__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .project__link { display: grid; gap: 4px; }
  .project__pill {
    display: flex;
    align-items: center;
    height: 58px;
    padding: 0 24px;
    background: #ffffff;
    border-radius: 18px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .project__tile {
    position: relative;
    display: block;
    aspect-ratio: 689 / 502;
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface);
  }
  .project__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out), filter 0.5s var(--ease-out);
  }
  .project:not(.is-visible) .project__tile img { filter: blur(14px); }
  .project.is-visible .project__tile img {
    filter: blur(0);
    transition: filter var(--spring-duration) var(--spring), transform 0.7s var(--ease-out);
  }
  @media (hover: hover) {
    .project__link:hover .project__tile img { transform: scale(1.06); filter: blur(9px); }
  }

  @media (max-width: 809px) {
    .pj__row { grid-template-columns: 1fr; gap: 18px; }
    .pj__spacer { display: none; }
    .pj__industryRow { padding-block: 0; }
    .pj__industry { font-size: 1.25rem; } /* phone: Industry value uses the 20px style */
    .pjnext__grid { grid-template-columns: 1fr; }
  }
</style>
