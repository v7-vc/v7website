---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const idx = projects.findIndex((p) => p.slug === project.slug);
// original shows the next 5 projects (wrapping around, current excluded)
const next = Array.from({ length: 5 }, (_, i) => projects[(idx + 1 + i) % projects.length]);
---
<Base title={`V7 – ${project.name}`} description={project.tagline}>
  <Header />
  <main>
    <section class="pj">
      <div class="container">
        <h1 class="pj__title" data-reveal>{project.name}</h1>

        <div class="pj__row" data-reveal>
          <span class="pj__label"><span class="pj__plus" aria-hidden="true">+</span> Introduction</span>
          <p class="pj__tagline">{project.tagline}</p>
        </div>

        <div class="pj__row" data-reveal>
          <span class="pj__label pj__label--plain">Industry</span>
          <p class="pj__industry">{project.industry}</p>
        </div>

        <div class="pj__row" data-reveal>
          <span class="pj__label"><span class="pj__plus" aria-hidden="true">+</span> About</span>
          <div class="pj__aboutCol">
            {project.logo && <img class="pj__logo" src={project.logo} alt={project.name} loading="eager" />}
            <p class="pj__about">{project.about}</p>
            {project.url && (
              <a class="pj__site" href={project.url} target="_blank" rel="noopener noreferrer">
                Website <span class="pj__dot" aria-hidden="true"></span>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="pjnext">
      <div class="container">
        <div class="pjnext__head" data-reveal>
          <h2 class="pjnext__title">Next projects.</h2>
          <a class="pjnext__all" href="/projects">All projects</a>
        </div>
        <ul class="pjnext__grid" data-reveal-group="">
          {next.map((p) => (
            <li class="project" data-reveal-child>
              <a class="project__link" href={`/projects/${p.slug}`}>
                <span class="project__pill">{p.name}</span>
                <span class="project__tile">
                  <img src={p.card} alt={`${p.name} — ${p.category}`} loading="lazy" width="1060" height="772" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Base>

<style>
  .pj {
    background: var(--surface);
    padding-block: clamp(90px, 14vw, 200px) clamp(48px, 6vw, 90px);
  }
  .pj__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(3.4rem, 9.6vw, 9.25rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-bottom: clamp(80px, 12vw, 190px);
  }
  .pj__row {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(0, 1.05fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
    padding-block: clamp(28px, 4vw, 48px);
  }
  .pj__row + .pj__row { border-top: 1px solid var(--border); }

  .pj__label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pj__plus {
    display: inline-grid;
    place-items: center;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1rem; line-height: 1;
    font-family: var(--font-body);
  }
  .pj__tagline, .pj__industry {
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pj__industry { font-size: 1.125rem; }

  .pj__aboutCol { display: flex; flex-direction: column; gap: clamp(28px, 4vw, 48px); }
  .pj__logo { width: clamp(120px, 12vw, 170px); height: auto; object-fit: contain; align-self: flex-start; }
  .pj__about {
    font-family: var(--font-display-curved);
    font-size: clamp(1.5rem, 2.6vw, 2.375rem);
    line-height: 1.25;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pj__site {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 15px 26px;
    border-radius: 50px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
    transition: transform 0.3s var(--ease-out), filter 0.3s var(--ease-out);
  }
  .pj__site:hover { transform: translateY(-2px); filter: brightness(1.06); }
  .pj__dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; }

  /* ---- next projects ---- */
  .pjnext { background: var(--surface); padding-block: clamp(48px, 7vw, 100px) clamp(6px, 1vw, 10px); }
  .pjnext__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .pjnext__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(2.4rem, 4.2vw, 3.875rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: var(--ink);
  }
  .pjnext__all {
    padding: 14px 24px;
    border-radius: 50px;
    background: #0a0a0a;
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.04em;
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }
  .pjnext__all:hover { transform: translateY(-2px); opacity: 0.9; }

  .pjnext__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .project__link { display: grid; gap: 4px; }
  .project__pill {
    display: flex;
    align-items: center;
    height: 58px;
    padding: 0 24px;
    background: #ffffff;
    border-radius: 14px;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .project__tile {
    display: block;
    aspect-ratio: 689 / 502;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
  }
  .project__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out), filter 0.5s var(--ease-out);
  }
  .project:not(.is-visible) .project__tile img { filter: blur(14px); }
  .project.is-visible .project__tile img {
    filter: blur(0);
    transition: filter var(--spring-duration) var(--spring), transform 0.7s var(--ease-out);
  }
  @media (hover: hover) {
    .project__link:hover .project__tile img { transform: scale(1.06); filter: blur(9px); }
  }

  @media (max-width: 760px) {
    .pj__row { grid-template-columns: 1fr; gap: 18px; }
    .pjnext__grid { grid-template-columns: 1fr; }
  }
</style>
