---
import { projects } from '../data/projects';
interface Props { standalone?: boolean; }
const { standalone = false } = Astro.props;
---
<section class={`projects${standalone ? ' projects--standalone' : ''}`} id="projects">
  <div class="container">
    <div class="projects__head">
      {!standalone && <span class="projects__index" data-reveal>({projects.length})</span>}
      <h2 class="projects__title" data-reveal>Projects.</h2>
      {!standalone && (
        <p class="projects__lead" data-reveal style="--reveal-delay:120ms"><span class="projects__lead-indent" aria-hidden="true">{'                  '}</span>We back visionaries bold enough to reshape entire industries. Our founders don&rsquo;t just build companies, they spark revolutions. From daring ideas to market-leading ventures, we invest where others won&rsquo;t.</p>
      )}
    </div>

    <ul class="projects__grid" data-reveal-group="">
      {projects.map((p) => (
        <li class="project" data-reveal-child>
          <a class="project__link" href={`/projects/${p.slug}`}>
            <span class="project__pill">
              <span class="project__swap">
                <span class="project__name">{p.name}</span>
                <span class="project__cat">{p.category}</span>
              </span>
              <span class="project__dots" aria-hidden="true"><span></span><span></span><span></span></span>
            </span>
            <span class="project__tile">
              <img src={p.card} alt={`${p.name} — ${p.category}`} loading="lazy" width="1060" height="596" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects {
    background: var(--surface);
    padding-block: clamp(64px, 8vw, 110px) clamp(6px, 1vw, 10px);
  }
  /* Desktop: the original's hero-panel-bottom → heading gap is a fixed 306px;
     230px of it is the hero's light fold area, so the section adds 76px. */
  @media (min-width: 861px) {
    .projects { padding-top: 76px; }
  }
  /* standalone /projects page: big left-aligned title, no index, no lead.
     Original <main> has padding-top:340px with a 62px fixed header; our header
     is in-flow (62px) so we use 278px to land the title at the same 340px. */
  .projects--standalone {
    padding-block: clamp(140px, 19.3vw, 278px) clamp(6px, 1vw, 10px);
  }
  .projects--standalone .projects__head { margin-bottom: clamp(40px, 6vw, 72px); }
  .projects--standalone .projects__title {
    margin-left: 0;
    text-align: left;
    /* original keeps the title at a fixed 62px across all breakpoints */
    font-size: 3.875rem;
  }
  /* The category lives inside the pill (stacked on the name) on both the
     homepage grid and /projects — never as an overlay on the image. */

  /* ---- head ---- */
  .projects__head {
    position: relative;
    margin-bottom: clamp(64px, 12.6vw, 182px);
  }
  /* Original desktop: heading-top → first card = 308px fixed (title is 57 tall,
     so 251px below the head block); the lead ends 81px above the cards. */
  @media (min-width: 1200px) {
    .projects__head { margin-bottom: 251px; }
  }
  .projects__index {
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: #000000; /* reference #97 text colour */
    opacity: 0.6; /* wrapper #96 carries opacity 0.6 */
  }
  .projects__title {
    text-align: left;
    margin-left: 25%; /* lands the heading at x≈346 @1309 (spec); 26% sat at 358 */
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 3.875rem; /* fixed 62px like the original (was vw-clamp that shrank below 1438px) */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: var(--ink);
    padding-top: 0;
    /* original top-aligns the heading with the "(8)" index (both y equal —
       measured live); no vertical offset */
  }
  .projects__lead {
    position: absolute;
    /* original drops the lead 76px below the heading top (measured live) */
    top: 76px;
    /* spec @1309: lead box 985..1294 — overhangs our container's right edge by
       21px (original insets it 15px from the viewport, not 36) */
    right: -21px;
    width: 309px;
    max-width: 32%;
    margin: 0;
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  /* original: the DESKTOP lead has no first-line indent; the PHONE variant
     carries 18 literal leading spaces — shown only there */
  .projects__lead-indent { display: none; }
  @media (max-width: 809px) {
    .projects__lead { white-space: pre-wrap; }
    .projects__lead-indent { display: inline; }
  }

  /* ---- grid ---- */
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .project__link { display: grid; gap: 4px; }
  .project__pill {
    display: flex;
    align-items: center;
    height: 58px;
    padding: 0 24px;
    background: #ffffff;
    border-radius: 18px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #000;
  }
  /* Reference: the project name and its category share one box (both at
     x=59.99 y=1266.36 inside the pill). The category is overlaid on the name
     and is #ffffff, so it reads as invisible against the white pill — the
     original never shows it at rest or on hover (verified in .shots). It is
     stacked here rather than painted over the image so the DOM matches. */
  .project__swap { position: relative; display: inline-block; }
  .project__cat {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    color: #ffffff;
    pointer-events: none;
  }
  /* three dots on the right of the pill, revealed on hover.
     Reference geometry: 8px circles, 3px apart (x=598.6/609.5/620.5, container
     30px wide), right-aligned against the pill's 24px padding. In the DOM they
     are #ffffff (invisible on the white pill at rest); the original's hover
     shot shows them pink, so they fade in with the accent colour. */
  .project__dots {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }
  .project__dots span {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (hover: hover) {
    .project__link:hover .project__dots { opacity: 1; }
  }
  /* image tile = white frame with the image inset 4px (matches original) */
  .project__tile {
    position: relative;
    display: block;
    aspect-ratio: 682 / 499.32;
    border-radius: 18px;
    padding: 4px;
    overflow: hidden;
    background: #ffffff;
  }
  .project__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    transition: transform 0.7s var(--ease-out), filter 0.5s var(--ease-out);
    will-change: filter, transform;
  }
  /* scroll-in: card image resolves from blur (as on the original) */
  .project:not(.is-visible) .project__tile img { filter: blur(14px); }
  .project.is-visible .project__tile img {
    filter: blur(0);
    transition: filter var(--spring-duration) var(--spring), transform 0.7s var(--ease-out);
  }
  @media (hover: hover) {
    .project__link:hover .project__tile img {
      transform: scale(1.06);
      filter: blur(9px);
    }
  }

  /* Original phone (<810): heading left at the gutter, lead = a 350px block
     under it, cards full-width, pill inset 20 */
  @media (max-width: 809px) {
    .projects__head { min-height: 0; margin-bottom: 32px; }
    .projects__index { position: static; display: block; margin-bottom: 8px; }
    .projects__title { text-align: left; margin-left: 0; padding-top: 0; transform: none; }
    .projects__lead { position: static; width: 100%; max-width: 350px; margin-top: 20px; }
    .projects__grid { grid-template-columns: 1fr; }
    .project__pill { border-radius: 14px; padding: 0 20px; }
    /* original mobile: title stays 62px, top gap ~140px, pill/tile radius 14px */
    .projects--standalone { padding-block: 78px clamp(6px, 1vw, 10px); }
    .projects--standalone .projects__head { margin-bottom: 32px; }
    .project__tile { border-radius: 14px; }
    .project__tile img { border-radius: 11px; }
  }
</style>
