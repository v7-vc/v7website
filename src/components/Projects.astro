---
import { projects } from '../data/projects';
interface Props { standalone?: boolean; }
const { standalone = false } = Astro.props;
---
<section class={`projects${standalone ? ' projects--standalone' : ''}`} id="projects">
  <div class="container">
    <div class="projects__head">
      {!standalone && <span class="projects__index" data-reveal>(8)</span>}
      <h2 class="projects__title" data-reveal>Projects.</h2>
      {!standalone && (
        <p class="projects__lead" data-reveal style="--reveal-delay:120ms">
          We back visionaries bold enough to reshape entire industries. Our founders
          don&rsquo;t just build companies, they spark revolutions. From daring ideas to
          market-leading ventures, we invest where others won&rsquo;t.
        </p>
      )}
    </div>

    <ul class="projects__grid" data-reveal-group="">
      {projects.map((p) => (
        <li class="project" data-reveal-child>
          <a class="project__link" href={`/projects/${p.slug}`}>
            <span class="project__pill">
              <span class="project__name">{p.name}</span>
              <span class="project__dots" aria-hidden="true"><span></span><span></span><span></span></span>
            </span>
            <span class="project__tile">
              <span class="project__cat">{p.category}</span>
              <img src={p.card} alt={`${p.name} — ${p.category}`} loading="lazy" width="1060" height="596" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects {
    background: var(--surface);
    padding-block: clamp(64px, 8vw, 110px) clamp(6px, 1vw, 10px);
  }
  /* standalone /projects page: big left-aligned title, no index, no lead.
     Original <main> has padding-top:340px with a 62px fixed header; our header
     is in-flow (62px) so we use 278px to land the title at the same 340px. */
  .projects--standalone {
    padding-block: clamp(140px, 19.3vw, 278px) clamp(6px, 1vw, 10px);
  }
  .projects--standalone .projects__head { margin-bottom: clamp(40px, 6vw, 72px); }
  .projects--standalone .projects__title {
    margin-left: 0;
    text-align: left;
    /* original keeps the title at a fixed 62px across all breakpoints */
    font-size: 3.875rem;
  }
  /* On /projects the original hides the category tag at rest (revealed on hover
     inside the pill), so it is not shown as a persistent overlay here. */
  /* category hover-reveal behavior is shared with the homepage grid */

  /* ---- head ---- */
  .projects__head {
    position: relative;
    /* Original leaves a large gap (~269px heading→first card) so the cards only
       appear well after the hero fold. Matches v7.vc measured at 1440w. */
    margin-bottom: clamp(64px, 12.6vw, 182px);
  }
  .projects__index {
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .projects__title {
    text-align: left;
    margin-left: 25%; /* lands the heading at x≈346 @1309 (spec); 26% sat at 358 */
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 3.875rem; /* fixed 62px like the original (was vw-clamp that shrank below 1438px) */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: var(--ink);
    padding-top: 0;
    /* raise the word so it sits high next to (8) / the lead, like the original */
    transform: translateY(-60px);
  }
  .projects__lead {
    position: absolute;
    /* original drops the lead ~76px below the heading top (measured on v7.vc) */
    top: 36px;
    /* spec @1309: lead box 985..1294 — overhangs our container's right edge by
       21px (original insets it 15px from the viewport, not 36) */
    right: -21px;
    width: 309px;
    max-width: 32%;
    margin: 0;
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  /* ---- grid ---- */
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .project__link { display: grid; gap: 4px; }
  .project__pill {
    display: flex;
    align-items: center;
    height: 58px;
    padding: 0 24px;
    background: #ffffff;
    border-radius: 18px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #000;
  }
  /* three pink dots on the right of the pill, revealed on hover (like the original) */
  .project__dots {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }
  .project__dots span {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (hover: hover) {
    .project__link:hover .project__dots { opacity: 1; }
  }
  /* image tile = white frame with the image inset 4px (matches original) */
  .project__tile {
    position: relative;
    display: block;
    aspect-ratio: 682 / 499.32;
    border-radius: 18px;
    padding: 4px;
    overflow: hidden;
    background: #ffffff;
  }
  .project__cat {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #fff;
    pointer-events: none;
    /* original hides the category at rest; it fades in on hover */
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  @media (hover: hover) {
    .project__link:hover .project__cat { opacity: 1; }
  }
  .project__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    transition: transform 0.7s var(--ease-out), filter 0.5s var(--ease-out);
    will-change: filter, transform;
  }
  /* scroll-in: card image resolves from blur (as on the original) */
  .project:not(.is-visible) .project__tile img { filter: blur(14px); }
  .project.is-visible .project__tile img {
    filter: blur(0);
    transition: filter var(--spring-duration) var(--spring), transform 0.7s var(--ease-out);
  }
  @media (hover: hover) {
    .project__link:hover .project__tile img {
      transform: scale(1.06);
      filter: blur(9px);
    }
  }

  /* Original phone (<810): heading left at the gutter, lead = a 350px block
     under it, cards full-width, pill inset 20 */
  @media (max-width: 809px) {
    .projects__head { min-height: 0; margin-bottom: 32px; }
    .projects__index { position: static; display: block; margin-bottom: 8px; }
    .projects__title { text-align: left; margin-left: 0; padding-top: 0; transform: none; }
    .projects__lead { position: static; width: 100%; max-width: 350px; margin-top: 20px; }
    .projects__grid { grid-template-columns: 1fr; }
    .project__pill { border-radius: 14px; padding: 0 20px; }
    /* original mobile: title stays 62px, top gap ~140px, pill/tile radius 14px */
    .projects--standalone { padding-block: 78px clamp(6px, 1vw, 10px); }
    .projects--standalone .projects__head { margin-bottom: 32px; }
    .project__tile { border-radius: 14px; }
    .project__tile img { border-radius: 11px; }
  }
</style>
