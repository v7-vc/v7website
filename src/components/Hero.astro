---
const video = '/assets/media/dOgk0Vxkcux0KWiIAWgeNGdfs.mp4';
---
<section class="hero" id="top">
  <div class="hero__panel">
    <video class="hero__video" autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src="/assets/media/hero-800.mp4" type="video/mp4" media="(max-width: 809px)" />
      <source src={video} type="video/mp4" />
    </video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__content">
      {/* The original indents lines 2/3 with literal leading spaces (6 and 14)
          rendered via white-space: pre-wrap — replicated verbatim so the
          staircase scales with the font at every breakpoint. */}
      <h1 class="hero__title">
        <span class="reveal-line" style="--reveal-delay:500ms"><span>Turning improbable</span></span>
        <span class="reveal-line" style="--reveal-delay:640ms"><span>{'      '}visions into</span></span>
        <span class="reveal-line hero__accent" style="--reveal-delay:740ms"><span>{'              '}(unstoppable ventures)</span></span>
      </h1>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const panel = document.querySelector('.hero__panel');
    const header = document.querySelector('.header');
    if (!panel) return;
    const fit = () => {
      const h = (header ? header.offsetHeight : 62);
      // 6px top gap + 6px bottom gap so the rounded bottom corners stay visible
      panel.style.setProperty('--hero-h', (window.innerHeight - h - 12) + 'px');
    };
    fit();
    window.addEventListener('resize', fit, { passive: true });
    window.addEventListener('orientationchange', fit);
  })();
</script>

<style>
  .hero {
    padding: 6px 6px 0;
    background: var(--surface);
  }
  /* Desktop, motion on: extend the first screen with a light area below the panel.
     The panel folds ONTO this light background (its rounded bottom corners stay
     visible) and the next block starts below it instead of covering the fold —
     exactly like the original. 196px > the panel's 180px max downward travel, so
     the next section can never overlap the folding panel; with the Projects
     section's own top padding the heading lands ~viewport-height + 300px (doc
     ~1200 at 900px tall), matching the original. */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    .hero { padding-bottom: 230px; }
  }
  .hero__panel {
    position: relative;
    height: var(--hero-h, calc(100svh - 68px));
    min-height: 560px;
    border-radius: 25px;
    overflow: hidden;
    background: #0a0a0a;
    isolation: isolate;
  }
  /* Phone (<810px): the original does NOT make the hero full-height here — it is a
     short fixed panel (~523px at 390w) with a 16px radius and ~2px inset. Full-
     height on phone made the whole page ~250px too tall and felt un-adaptive. */
  @media (max-width: 809px) {
    .hero { padding: 2px 2px 0; }
    .hero__panel {
      height: auto;
      aspect-ratio: 386 / 523;
      min-height: 0;
      border-radius: 16px;
    }
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 42%),
      linear-gradient(to right, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0) 45%);
  }
  .hero__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    /* horizontal padding tuned so the headline lands at x≈40 @1309 (spec),
       matching the section gutter; vertical padding keeps the bottom anchor */
    padding: clamp(28px, 4vw, 60px) clamp(22px, 2.6vw, 40px);
  }
  .hero__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(1.75rem, 6vw, 3.375rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #ffffff;
  }
  /* Desktop breakpoint (≥1200) renders the original's leading-space staircase;
     below that the original's tablet/phone variants drop the indents, and with
     normal white-space the leading spaces collapse to nothing. pre-wrap goes on
     the inner spans only — on the container it would also render the whitespace
     between the line elements as extra blank lines. */
  @media (min-width: 1200px) {
    .hero__title .reveal-line > span { white-space: pre-wrap; }
  }
  /* Original phone (<810): headline is a fixed 37px / 350px block, centred in
     the panel (x=193 @736, x=20 @390) */
  @media (max-width: 809px) {
    .hero__content { padding-inline: 18px; }
    .hero__title {
      font-size: 2.3125rem;
      width: 100%;
      max-width: 350px;
      margin-inline: auto;
    }
  }
  .hero__accent > span {
    font-family: var(--font-display-curved);
    color: #f55397;
  }
</style>
