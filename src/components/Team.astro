---
import { team } from '../data/team';
---
<section class="team">
  <div class="container">
    <div class="team__panel">
      <div class="team__inner">
        <div class="team__content">
          <div class="team__head">
            <h2 class="team__title" data-reveal>
              <span class="team__ink">The faces</span> <span class="team__muted">behind the projects.</span>
            </h2>
            <span class="team__underline" data-reveal style="--reveal-delay:180ms"></span>
          </div>

          <ul class="team__grid" data-reveal-group="">
            {team.map((m, i) => {
              const Tag = m.linkedin ? 'a' : 'div';
              return (
                <li class="member" data-reveal-child style={`--reveal-delay:${i * 70}ms`}>
                  <Tag
                    class="member__link"
                    {...(m.linkedin ? { href: m.linkedin, target: '_blank', rel: 'noopener' } : {})}
                  >
                    <span class="member__media">
                      <img class="member__photo" src={m.photo} alt={m.name} loading="lazy" />
                    </span>
                    <span class="member__body">
                      <span class="member__head">
                        <span class="member__li" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M6.94 5A1.94 1.94 0 1 1 3.06 5a1.94 1.94 0 0 1 3.88 0ZM3.4 8.4h3.1V21H3.4V8.4Zm5.03 0h2.97v1.72h.04c.41-.78 1.42-1.6 2.93-1.6 3.13 0 3.71 2.06 3.71 4.74V21h-3.09v-5.55c0-1.32-.02-3.02-1.84-3.02-1.84 0-2.12 1.44-2.12 2.93V21H8.43V8.4Z"/>
                          </svg>
                        </span>
                        <span class="member__role">{m.role}</span>
                      </span>
                      <span class="member__name">{m.name}</span>
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>

          <!-- Reference (div.framer-13ulh3h) renders a 100×3 block with no fill and
               div.framer-1ip96ra a 658×2 white rule below the grid. Both are invisible
               on the white panel but carry 35px of the panel's height — kept so the
               panel measures 610.98px at 1309, exactly like the original. -->
          <span class="team__bar" aria-hidden="true"></span>
        </div>
        <span class="team__rule" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .team { background: var(--surface); }

  /* Reference @1309: inset white card at x=36 w=1237 (the .container gutter),
     radius 25px on ALL corners, 10px outer padding + 60/90/60/60 inner padding. */
  .team__panel {
    background: #ffffff;
    border-radius: 25px;
    padding: 10px;
  }
  .team__inner {
    padding: 60px 90px 60px 60px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* content column caps at 1030px → six 163.33px cards with 10px gaps @1309 */
  .team__content {
    width: 100%;
    max-width: 1030px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
  }
  .team__head {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
  }

  .team__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(2rem, 7.4vw, 3.75rem); /* 60px desktop (cap ~810px) → 32px mobile, like original */
    line-height: 1.1;
    letter-spacing: -0.06em;
    max-width: 14ch;
  }
  .team__ink { color: #090909; }
  .team__muted { color: rgba(10, 10, 10, 0.6); }
  .team__underline {
    display: block;
    width: 168px;
    max-width: 100%;
    height: 3px;
    background: var(--accent);
  }
  .team__bar { display: block; width: 100px; height: 3px; }
  .team__rule {
    display: block;
    align-self: center;
    width: 658px;
    max-width: 100%;
    height: 2px;
    background: #ffffff;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
  }

  /* Card: #0a0a0a plate, 18px radius, 20px inset on all four sides; the photo
     sits on top at opacity .8 (no gradients — reference has none). */
  .member__link {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 4px;
    aspect-ratio: 163.33 / 240.99;
    padding: 20px;
    background: #0a0a0a;
    border-radius: 18px;
    overflow: hidden;
    isolation: isolate;
  }
  .member__media {
    position: absolute;
    inset: 0;
    opacity: 0.8;
  }
  .member__photo {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }
  @media (hover: hover) {
    .member__link:hover .member__photo { transform: scale(1.05); }
  }
  .member__body {
    position: relative;
    z-index: 1;
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }
  .member__head {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  /* bare 18×18 mark — the reference has no circle/backdrop behind it */
  .member__li {
    flex: none;
    display: block;
    width: 18px;
    height: 18px;
    color: #fff;
  }
  .member__li svg { display: block; width: 100%; height: 100%; }
  /* role fills the rest of the row and is right-aligned, so "Head of Legal"
     wraps to two lines at ~85px like the reference */
  .member__role {
    flex: 1 0 0;
    text-align: right;
    font-family: var(--font-display-curved);
    font-size: 1rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #fff;
  }
  /* original renders the founder's role tag larger (18px vs 16px) */
  .member:first-child .member__role { font-size: 1.125rem; }
  .member__name {
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #fff;
  }

  @media (max-width: 1000px) {
    .team__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* Original phone/tablet: ONE centred 330×365 card per row inside a 350-wide
     white panel (padding 39px 10px, radius 16px); heading block is 290px wide,
     32px type; card radius 12px, 24px insets; name 24px, role 22px. */
  @media (max-width: 809px) {
    .team__panel { border-radius: 16px; padding: 39px 10px; }
    .team__inner { padding: 0; align-items: stretch; }
    .team__content { max-width: none; align-items: stretch; gap: 34px; }
    .team__head { max-width: 290px; margin-inline: auto; gap: 14px; }
    .team__title {
      max-width: 290px;
      font-size: 2rem;
      text-align: left;
    }
    .team__underline { height: 2px; }
    .team__bar, .team__rule { display: none; }
    .team__grid {
      grid-template-columns: minmax(0, 330px);
      justify-content: center;
      gap: 4px;
      max-width: none;
    }
    .member__link { aspect-ratio: 330 / 365; border-radius: 12px; padding: 24px; }
    .member__li { width: 24px; height: 24px; }
    .member__name { font-size: 1.5rem; }
    .member__role { font-size: 1.375rem; }
    .member:first-child .member__role { font-size: 1.375rem; }
  }
</style>
