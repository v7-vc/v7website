---
import { faqGroups } from '../data/faq';
---
<section class="faq" id="faq">
  <div class="container">
    <div class="faq__groups">
      {faqGroups.map((group, gi) => (
        <div class={`faq__group${gi === 1 ? ' faq__group--light' : ''}`}>
          {/* "FAQ." lives INSIDE the first group's left column, so the first
              question card starts at exactly the title's top edge. */}
          <div class="faq__group-head">
            {gi === 0 && <h2 class="faq__title" data-reveal>FAQ.</h2>}
            <h3 class="faq__group-title" data-reveal>{group.title}</h3>
            <span class="faq__group-underline" data-reveal style="--reveal-delay:140ms"></span>
          </div>

          <div class="faq__group-list">
            {group.items.map((item, ii) => (
              <div class={`faq__item${ii === 0 ? ' is-open' : ''}`} data-faq-item data-reveal>
                <button class="faq__trigger" data-faq-trigger aria-expanded={ii === 0 ? 'true' : 'false'}>
                  <span class="faq__q">{item.q}</span>
                  <span class="faq__icon" aria-hidden="true"><span></span><span></span></span>
                </button>
                <div class="faq__panel" data-faq-panel>
                  <p>{item.a}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--surface);
    padding-block: clamp(64px, 9vw, 120px);
  }

  /* The original ships the two blocks as two sections in a stack with a 168px
     gap (40px on phone/tablet). */
  .faq__groups { display: flex; flex-direction: column; gap: 168px; }

  /* label (left) + questions (right), 4px apart → two 616.55px columns @1309,
     so the question cards start at x=656.5. The label sits at the top of its
     own question block, like the original — no sticky, no swap. */
  .faq__group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    align-items: start;
  }
  .faq__group-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .faq__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 3.875rem; /* fixed 62px like the original */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-bottom: 30px;
  }
  .faq__group-title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(1.6rem, 4.69vw, 2.375rem);
    line-height: 1.1;
    letter-spacing: -0.05em;
    color: #090909;
    max-width: 380px; /* spec: "For Investors (LPs / Angels / Co-Investors)" wraps to 2 lines in 380px */
  }
  .faq__group-underline {
    display: block;
    width: 100%;
    max-width: 200px;
    height: 3px;
    background: var(--accent);
    margin-top: 30px;
  }

  /* cards are stacked 4px apart */
  .faq__group-list { display: flex; flex-direction: column; gap: 4px; }

  /* Original renders the "For Investors (LPs / Angels / Co-Investors)" block in
     Marund Curved LIGHT (300) — questions and answers only; the group title
     stays 400, same as the Founders block. */
  .faq__group--light .faq__q,
  .faq__group--light .faq__panel p { font-weight: 300; }

  /* cards run ~10% smaller than the extracted spec, by request */
  .faq__item {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
  }
  .faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    padding: 23px;
  }
  .faq__q {
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  /* Reference icon is an 18×18 image: a #0a0a0a disc with a white 8×2 plus,
     18px clear of the question — not a 40×40 button. */
  .faq__icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 16px; height: 16px;
    margin-left: 16px;
    border-radius: 50%;
    background: #0a0a0a;
    transition: transform 0.45s var(--ease-out);
  }
  .faq__icon span {
    position: absolute;
    width: 8px; height: 2px;
    background: #fff;
  }
  .faq__icon span:last-child { transform: rotate(90deg); }
  /* open: the "+" spins a quarter turn and stays a "+" (plus → plus) */
  .is-open .faq__icon { transform: rotate(90deg); }

  .faq__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s var(--ease-out);
  }
  .faq__panel p {
    /* answer text insets shrink with the card (~10% under spec) */
    padding: 0 25px 25px;
    font-family: var(--font-display-curved);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: rgba(10, 10, 10, 0.6);
  }

  /* Original phone/tablet: label above questions (40px apart); title 28px;
     underline 168×2 at 18px; card insets 20px */
  @media (max-width: 809px) {
    .faq__groups { gap: 40px; }
    .faq__group { grid-template-columns: 1fr; gap: 40px; }
    .faq__title { margin-bottom: 22px; }
    .faq__group-title { max-width: 380px; font-size: 1.75rem; }
    .faq__group-underline { max-width: 168px; height: 2px; margin-top: 18px; }
    .faq__trigger { padding: 20px; }
    .faq__panel p { padding: 0 20px 20px; }
  }
</style>
