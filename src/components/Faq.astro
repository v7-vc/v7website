---
import { faqGroups } from '../data/faq';
---
<section class="faq" id="faq">
  <div class="container">
    <h2 class="faq__title" data-reveal>FAQ.</h2>

    <div class="faq__groups">
      {faqGroups.map((group, gi) => (
        <div class={`faq__group${gi === 1 ? ' faq__group--light' : ''}`}>
          <div class="faq__group-head">
            <h3 class="faq__group-title" data-reveal>{group.title}</h3>
            <span class="faq__group-underline" data-reveal style="--reveal-delay:140ms"></span>
          </div>

          <div class="faq__group-list">
            {group.items.map((item, ii) => (
              <div class={`faq__item${ii === 0 ? ' is-open' : ''}`} data-faq-item data-reveal>
                <button class="faq__trigger" data-faq-trigger aria-expanded={ii === 0 ? 'true' : 'false'}>
                  <span class="faq__q">{item.q}</span>
                  <span class="faq__icon" aria-hidden="true"><span></span><span></span></span>
                </button>
                <div class="faq__panel" data-faq-panel>
                  <p>{item.a}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--surface);
    padding-block: clamp(64px, 9vw, 120px);
  }
  .faq__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 3.875rem; /* fixed 62px like the original */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-bottom: clamp(28px, 3.4vw, 44px);
  }

  .faq__groups { display: flex; flex-direction: column; gap: clamp(48px, 7vw, 96px); }

  /* Each group: static label (left) beside its questions (right) — no sticky,
     no swap. The label sits at the top of its own question block, like the original. */
  /* label (left) + questions (right). The questions column begins at ~50% so the
     card text lands at x≈684 @1309 (spec); a wide gap pushed it ~33px too far right. */
  .faq__group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: start;
  }
  .faq__group-title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(1.6rem, 4.69vw, 2.375rem);
    line-height: 1.1;
    letter-spacing: -0.05em;
    color: #090909;
    max-width: 380px; /* spec: "For Investors (LPs / Angels / Co-Investors)" wraps to 2 lines in 380px */
  }
  .faq__group-underline {
    display: block;
    width: 100%;
    max-width: 270px;
    height: 3px;
    background: var(--accent);
    margin-top: 22px;
  }

  .faq__group-list { display: flex; flex-direction: column; gap: 12px; }

  /* Original renders the "For Investors (LPs / Angels / Co-Investors)" block in
     Marund Curved LIGHT (300) — questions and answers only; the group title
     stays 400, same as the Founders block. */
  .faq__group--light .faq__q,
  .faq__group--light .faq__panel p { font-weight: 300; }

  .faq__item {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
  }
  .faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    text-align: left;
    padding: 28px 30px;
  }
  .faq__q {
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .faq__icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: #0a0a0a;
    transition: transform 0.45s var(--ease-out);
  }
  .faq__icon span {
    position: absolute;
    width: 14px; height: 1.6px;
    background: #fff;
  }
  .faq__icon span:last-child { transform: rotate(90deg); }
  /* open: the "+" spins a quarter turn and stays a "+" (plus → plus) */
  .is-open .faq__icon { transform: rotate(90deg); }

  .faq__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s var(--ease-out);
  }
  .faq__panel p {
    /* spec: answer text spans the card minus insets (~561px @1309) — no ch cap */
    padding: 0 30px 30px;
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: rgba(10, 10, 10, 0.6);
  }

  /* Original phone: label above questions; title 28px; card insets 20px
     (question x=40, answer x=40 w=652 @736) */
  @media (max-width: 809px) {
    .faq__group { grid-template-columns: 1fr; gap: 20px; }
    .faq__group-title { max-width: 380px; font-size: 1.75rem; }
    .faq__trigger { padding: 24px 20px; }
    .faq__panel p { padding: 0 20px 24px; }
  }
</style>
