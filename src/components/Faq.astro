---
import { faqGroups } from '../data/faq';
---
<section class="faq" id="faq">
  <div class="container">
    {faqGroups.map((group, gi) => (
      <div class="faq__group">
        <aside class="faq__aside">
          {gi === 0 && <h2 class="faq__title" data-reveal>FAQ.</h2>}
          <h3 class="faq__group-title" data-reveal style="--reveal-delay:80ms">{group.title}</h3>
          <span class="faq__underline" data-reveal style="--reveal-delay:180ms"></span>
        </aside>

        <div class="faq__items">
          {group.items.map((item, ii) => (
            <div class={`faq__item${gi === 0 && ii === 0 ? ' is-open' : ''}`} data-faq-item data-reveal>
              <button class="faq__trigger" data-faq-trigger aria-expanded={gi === 0 && ii === 0 ? 'true' : 'false'}>
                <span class="faq__q">{item.q}</span>
                <span class="faq__icon" aria-hidden="true"><span></span><span></span></span>
              </button>
              <div class="faq__panel" data-faq-panel>
                <p>{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .faq {
    background: var(--surface);
    padding-block: clamp(64px, 9vw, 120px);
  }
  .faq__group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .faq__group + .faq__group { margin-top: clamp(48px, 6vw, 80px); }

  .faq__aside { position: static; }
  .faq__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(2.4rem, 4.2vw, 3.875rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .faq__group-title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.6vw, 2.375rem);
    line-height: 1.1;
    letter-spacing: -0.05em;
    color: #090909;
    max-width: 12ch;
  }
  .faq__underline {
    display: block;
    width: 100%;
    max-width: 270px;
    height: 3px;
    background: var(--accent);
    margin-top: 22px;
  }

  .faq__items { display: flex; flex-direction: column; gap: 12px; }
  .faq__item {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
  }
  .faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    text-align: left;
    padding: 28px 30px;
  }
  .faq__q {
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .faq__icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: #0a0a0a;
  }
  .faq__icon span {
    position: absolute;
    width: 14px; height: 1.6px;
    background: #fff;
    transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
  }
  .faq__icon span:last-child { transform: rotate(90deg); }
  .is-open .faq__icon span:last-child { transform: rotate(0); opacity: 0; }

  .faq__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s var(--ease-out);
  }
  /* No-JS fallback: keep the pre-opened item readable */
  @media (scripting: none) {
    .faq__item.is-open .faq__panel { max-height: none; }
  }
  .faq__panel p {
    padding: 0 30px 30px;
    max-width: 52ch;
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: rgba(10, 10, 10, 0.6);
  }

  @media (max-width: 860px) {
    .faq__group { grid-template-columns: 1fr; }
    .faq__aside { position: static; }
  }
</style>
