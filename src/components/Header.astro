---
import { projects } from '../data/projects';
---
<header class="header" data-header>
  <div class="header__inner">
    <a href="/" class="logo" aria-label="V7 home">
      <img src="/assets/images/logo-v7.png" alt="V7" width="87" height="24" />
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="/projects" class="nav__link">Projects<sup>{projects.length}</sup></a>
      <a href="/contact" class="nav__link">Contact</a>
    </nav>

    <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="mobile-menu" data-menu>
  <nav class="menu__nav" aria-label="Menu">
    <a href="/">Home</a>
    <a href="/projects">Projects</a>
    <a href="/contact">Contact</a>
  </nav>
  <a class="menu__email" href="mailto:hello@v7.vc">hello@v7.vc</a>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    /* reference header: opaque #f5f5f5 with blur(7px), no saturate */
    background: #f5f5f5;
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
  }

  /* Framer signature: header items drop in from above (-40px) on load,
     using the same overdamped spring as the scroll reveals, lightly staggered. */
  @keyframes headerDrop {
    from { opacity: 0; transform: translateY(-40px); }
    to   { opacity: 1; transform: none; }
  }
  /* nav links are centred with translate(-50%,-50%); their drop keyframe must
     preserve that offset or they lose centring and shift ~30px right on land */
  @keyframes navDrop {
    from { opacity: 0; transform: translate(-50%, calc(-50% - 40px)); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo,
    .burger {
      animation: headerDrop var(--spring-duration, 1.15s) var(--spring, ease-out) both;
    }
    .nav__link {
      animation: navDrop var(--spring-duration, 1.15s) var(--spring, ease-out) both;
    }
    .logo { animation-delay: 40ms; }
    .nav__link:first-child { animation-delay: 110ms; }
    .nav__link:last-child { animation-delay: 170ms; }
    .burger { animation-delay: 130ms; }
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
    padding-inline: var(--gutter);
  }
  .logo { display: inline-flex; }
  /* reference img box is 87x24 with object-fit contain; the artwork (aspect
     2.392) letterboxes to 57.4x24 and sits flush against the box's left edge
     (measured at x=36, the gutter, in the original) */
  .logo img {
    width: 87px;
    height: 24px;
    object-fit: contain;
    object-position: left center;
  }

  /* Links pinned at the original's positions (~36% / ~66% of the width) */
  .nav {
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .nav__link:first-child {
    position: absolute;
    left: 36.4%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav__link:last-child {
    position: absolute;
    left: 65.8%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav__link {
    position: relative;
    color: #090909;
    transition: opacity 0.25s var(--ease-out);
  }
  .nav__link sup {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    /* reference: sup starts at x=515.6, the word ends at 506.96 → 9px after it,
       and its wrapper carries opacity 0.6 */
    margin-left: 9px;
    opacity: 0.6;
    vertical-align: super;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -3px;
    width: 100%; height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .nav__link:hover::after { transform: scaleX(1); }

  .burger {
    justify-self: end;
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    width: 59px;
    padding: 8px 0;
    z-index: 70;
  }
  .burger span {
    display: block;
    width: 100%; height: 2px;
    background: rgb(10, 10, 10);
    transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
  }
  /* open: two long lines cross into a shallow X (small rotation, not a tight 45°) */
  :global(html.menu-open) .burger span:first-child { transform: translateY(5px) rotate(9deg); }
  :global(html.menu-open) .burger span:last-child { transform: translateY(-5px) rotate(-9deg); }

  /* ---- mobile / overlay menu ---- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding: var(--gutter);
    background: #f5f5f5;
    color: var(--ink);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out), visibility 0.4s;
  }
  :global(html.menu-open) .menu { opacity: 1; visibility: visible; transform: none; }
  :global(html.menu-open) { overflow: hidden; }
  .menu__nav { display: flex; flex-direction: column; gap: 14px; }
  .menu__nav a {
    font-family: var(--font-display-curved);
    font-size: clamp(2.5rem, 12vw, 3.75rem);
    line-height: 1.2;
    letter-spacing: -0.06em;
    color: #0a0a0a;
    transition: color 0.25s var(--ease-out);
  }
  .menu__nav a:hover { color: var(--accent); }
  .menu__email {
    font-family: var(--font-display-curved);
    font-size: clamp(1.2rem, 5vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.05em;
    color: #090909;
  }

  @media (max-width: 640px) {
    .nav { display: none; }
    /* the logo box stays 87x24 at every breakpoint (mobile extract @390: 87x24) */
  }
  @media (min-width: 641px) {
    /* keep the overlay usable on desktop too, but it is opened only via the burger */
    .menu { justify-content: center; align-items: flex-start; }
  }
</style>
