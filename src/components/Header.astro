---
---
<header class="header" data-header>
  <div class="header__inner">
    <a href="/" class="logo" aria-label="V7 home">
      <img src="/assets/images/logo-v7.png" alt="V7" width="87" height="36" />
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="/projects" class="nav__link">Projects<sup>8</sup></a>
      <a href="#contact" class="nav__link">Contact</a>
    </nav>

    <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="mobile-menu" data-menu>
  <nav class="menu__nav" aria-label="Menu">
    <a href="/">Home</a>
    <a href="/projects">Projects</a>
    <a href="#contact">Contact</a>
  </nav>
  <a class="menu__email" href="mailto:hello@v7.vc">hello@v7.vc</a>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(7px) saturate(1.3);
    -webkit-backdrop-filter: blur(7px) saturate(1.3);
  }
  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
    padding-inline: var(--gutter);
  }
  .logo { display: inline-flex; }
  .logo img { width: 87px; height: auto; object-fit: contain; }

  /* Links pinned at the original's positions (~36% / ~66% of the width) */
  .nav { font-size: 1.0625rem; }
  .nav__link:first-child {
    position: absolute;
    left: 36.4%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav__link:last-child {
    position: absolute;
    left: 65.8%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav__link {
    position: relative;
    color: var(--ink);
    transition: opacity 0.25s var(--ease-out);
  }
  .nav__link sup { font-size: 0.62em; margin-left: 3px; vertical-align: super; }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -3px;
    width: 100%; height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .nav__link:hover::after { transform: scaleX(1); }

  .burger {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
    width: 34px;
    padding: 6px 0;
    z-index: 70;
  }
  .burger span {
    display: block;
    width: 34px; height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }
  :global(html.menu-open) .burger span:first-child { transform: translateY(3.75px) rotate(45deg); }
  :global(html.menu-open) .burger span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  /* ---- mobile / overlay menu ---- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding: var(--gutter);
    background: var(--ink);
    color: #fff;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out), visibility 0.4s;
  }
  :global(html.menu-open) .menu { opacity: 1; visibility: visible; transform: none; }
  :global(html.menu-open) { overflow: hidden; }
  .menu__nav { display: flex; flex-direction: column; gap: 14px; }
  .menu__nav a {
    font-family: var(--font-display-curved);
    font-size: clamp(2.5rem, 12vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    transition: color 0.25s var(--ease-out);
  }
  .menu__nav a:hover { color: var(--accent); }
  .menu__email {
    font-size: clamp(1.2rem, 5vw, 1.6rem);
    color: color-mix(in srgb, #fff 70%, transparent);
  }

  @media (max-width: 640px) {
    .nav { display: none; }
    .logo img { width: 74px; }
  }
  @media (min-width: 641px) {
    /* keep the overlay usable on desktop too, but it is opened only via the burger */
    .menu { justify-content: center; align-items: flex-start; }
  }
</style>
