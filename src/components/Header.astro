---
import { projects } from '../data/projects';
const year = new Date().getFullYear();
---
<header class="header" data-header>
  <div class="header__inner">
    <a href="/" class="logo" aria-label="V7 home">
      <img src="/assets/images/logo-v7.png" alt="V7" width="87" height="24" />
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="/projects" class="nav__link">Projects<sup>{projects.length}</sup></a>
      <a href="/contact" class="nav__link">Contact</a>
    </nav>

    <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="mobile-menu" data-menu>
  <nav class="menu__nav" aria-label="Menu">
    {[['/', 'Home'], ['/projects', 'Projects'], ['/contact', 'Contact']].map(([href, label]) => (
      <a href={href}>
        <span class="menuswap">
          <span class="menuswap__rest">{label}</span>
          <span class="menuswap__hover" aria-hidden="true">{label}</span>
        </span>
      </a>
    ))}
  </nav>
  <div class="menu__foot">
    <a class="menu__email" href="mailto:hello@v7.vc">
      <span class="menu__email-plus" aria-hidden="true"></span>
      <span class="menu__email-text">hello@v7.vc</span>
    </a>
    <p class="menu__copyright">&copy; {year} v7.vc</p>
  </div>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    /* reference header: opaque #f5f5f5 with blur(7px), no saturate */
    background: #f5f5f5;
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
  }

  /* Framer signature: header items drop in from above (-40px) on load,
     using the same overdamped spring as the scroll reveals, lightly staggered. */
  @keyframes headerDrop {
    from { opacity: 0; transform: translateY(-40px); }
    to   { opacity: 1; transform: none; }
  }
  /* nav links are centred with translate(-50%,-50%); their drop keyframe must
     preserve that offset or they lose centring and shift ~30px right on land */
  @keyframes navDrop {
    from { opacity: 0; transform: translate(-50%, calc(-50% - 40px)); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo,
    .burger {
      animation: headerDrop var(--spring-duration, 1.15s) var(--spring, ease-out) both;
    }
    .nav__link {
      animation: navDrop var(--spring-duration, 1.15s) var(--spring, ease-out) both;
    }
    .logo { animation-delay: 40ms; }
    .nav__link:first-child { animation-delay: 110ms; }
    .nav__link:last-child { animation-delay: 170ms; }
    .burger { animation-delay: 130ms; }
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
    padding-inline: var(--gutter);
  }
  .logo { display: inline-flex; }
  /* reference img box is 87x24 with object-fit contain; the artwork (aspect
     2.392) letterboxes to 57.4x24 and sits flush against the box's left edge
     (measured at x=36, the gutter, in the original) */
  .logo img {
    width: 87px;
    height: 24px;
    object-fit: contain;
    object-position: left center;
  }

  /* Links pinned at the original's positions (~36% / ~66% of the width) */
  .nav {
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .nav__link:first-child {
    position: absolute;
    left: 36.4%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav__link:last-child {
    position: absolute;
    left: 65.8%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav__link {
    position: relative;
    color: #090909;
    transition: opacity 0.25s var(--ease-out);
  }
  .nav__link sup {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    /* reference: sup starts at x=515.6, the word ends at 506.96 → 9px after it,
       and its wrapper carries opacity 0.6 */
    margin-left: 9px;
    opacity: 0.6;
    vertical-align: super;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -3px;
    width: 100%; height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .nav__link:hover::after { transform: scaleX(1); }

  .burger {
    justify-self: end;
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    width: 59px;
    padding: 8px 0;
    z-index: 70;
  }
  .burger span {
    display: block;
    width: 100%; height: 2px;
    background: rgb(10, 10, 10);
    transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
  }
  /* open: two long lines cross into a shallow X (small rotation, not a tight 45°) */
  :global(html.menu-open) .burger span:first-child { transform: translateY(5px) rotate(9deg); }
  :global(html.menu-open) .burger span:last-child { transform: translateY(-5px) rotate(-9deg); }

  /* ---- overlay menu ----
     Not a full-screen cover: the original is a PANEL that slides down from
     behind the header — inset from the viewport sides and a fixed height, so
     the page keeps showing underneath it. Exact values from the Framer export
     (.framer-1rfamfy): desktop 750px tall / 36px insets, tablet 750 / 32,
     phone 604 / 24. On a short window the panel is taller than the space left
     and simply fills it, which is why it can still look full-screen. */
  .menu {
    position: fixed;
    top: 62px; /* header height */
    left: var(--gutter);
    right: var(--gutter);
    height: 750px;
    max-height: calc(100dvh - 62px);
    z-index: 55;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #f5f5f5;
    color: var(--ink);
    visibility: hidden;
    transform: translateY(-100%);
    transition: transform 0.55s var(--ease-out), visibility 0.55s;
  }
  :global(html.menu-open) .menu { visibility: visible; transform: translateY(0); }
  :global(html.menu-open) { overflow: hidden; }
  /* Reference: the items are CENTRED (each centre = 653 against a 654.5
     viewport centre) and every one carries two stacked 60px labels — Marund
     Curved at rest, Inter 90px below it — so hovering slides both UP. No
     colour change. */
  .menu__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .menu__nav a {
    font-family: var(--font-display-curved);
    font-size: clamp(2.5rem, 12vw, 3.75rem);
    line-height: 1.2;
    letter-spacing: -0.06em;
    color: #0a0a0a;
  }
  .menuswap {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .menuswap__rest,
  .menuswap__hover {
    display: block;
    text-align: center;
    transition: transform 0.45s var(--ease-out);
  }
  .menuswap__hover {
    position: absolute;
    inset: 0;
    transform: translateY(110%);
    font-family: var(--font-body);
    font-weight: 400;
  }
  @media (hover: hover) {
    .menu__nav a:hover .menuswap__rest { transform: translateY(-110%); }
    .menu__nav a:hover .menuswap__hover { transform: translateY(0); }
  }
  /* email CTA: a pink "+" disc on the left, the address, and a bar under the
     text only — proportions read off the reference (disc ≈0.5em, 9px gap,
     2px rule ~10px below the 34px address) */
  /* original: the overlay's last row is `space-between / align-items:flex-end` —
     e-mail bottom-left, copyright bottom-right — pinned to the overlay bottom
     so the nav stays centred in the viewport */
  .menu__foot {
    position: absolute;
    /* flush with the panel's own edges — the panel is already inset by the
       gutter, which puts the e-mail at x=36 like the original */
    left: 0;
    right: 0;
    bottom: 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  /* preset txwsq6: 14px Marund Curved (13 tablet / 12 phone), #0a0a0a @ 0.6 */
  .menu__copyright {
    font-family: var(--font-display-curved);
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: #0a0a0a;
    opacity: 0.6;
  }
  .menu__email {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display-curved);
    font-size: clamp(1.2rem, 5vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.05em;
    color: #090909;
  }
  .menu__email-plus {
    position: relative;
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--accent);
  }
  .menu__email-plus::before,
  .menu__email-plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #fff;
  }
  .menu__email-plus::before { width: 44%; height: 2px; }
  .menu__email-plus::after  { width: 2px; height: 44%; }
  /* the bar is detached (top:100%) so it doesn't grow the text box — that keeps
     the "+" disc centred on the address itself, as in the reference */
  .menu__email-text {
    position: relative;
  }
  .menu__email-text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 4px);
    height: 2px;
    background: #0a0a0a;
  }

  @media (max-width: 1199px) {
    .menu__copyright { font-size: 13px; }
  }
  @media (max-width: 809px) {
    .menu__copyright { font-size: 12px; }
  }

  /* original phone panel is shorter (604px, 24px insets) */
  @media (max-width: 809px) {
    .menu { height: 604px; }
  }

  @media (max-width: 640px) {
    .nav { display: none; }
    /* the logo box stays 87x24 at every breakpoint (mobile extract @390: 87x24) */
  }
  @media (min-width: 641px) {
    /* the overlay works on desktop too (opened via the burger). Children stay
       full-width so .menu__nav can centre its items while the e-mail stays
       flush left, as in the original. */
    .menu { justify-content: center; }
  }
</style>
