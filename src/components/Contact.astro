---
import { FORM_ENDPOINT, FORM_KEY, FORM_PROVIDER, FORM_CONFIGURED } from '../config/form';
const video = '/assets/media/dOgk0Vxkcux0KWiIAWgeNGdfs.mp4';
---
<section class="contact" id="contact">
  <div class="contact__panel">
    <video class="contact__video" poster="/assets/images/vrhxHFTuxnCduP4nljUulqZcuQ.jpg" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="/assets/media/hero-800.mp4" type="video/mp4" media="(max-width: 809px)" />
      <source src={video} type="video/mp4" />
    </video>
    <div class="contact__scrim" aria-hidden="true"></div>

    <div class="container contact__inner">
      <div class="contact__grid">
        <form class="cform" action={FORM_ENDPOINT} method="post" data-contact-form data-provider={FORM_PROVIDER}>
          {FORM_CONFIGURED && <input type="hidden" name="access_key" value={FORM_KEY} />}
          <input type="checkbox" name="botcheck" class="cform__botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <img class="cform__logo" src="/assets/images/logo-v7.png" alt="V7" width="87" height="24" />
          <div class="cform__fields">
            <div class="field">
              <label for="name">Your name*</label>
              <input id="name" name="name" type="text" placeholder="John Doe" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">E-mail*</label>
              <input id="email" name="email" type="email" placeholder="hello@site.com" required autocomplete="email" />
            </div>
            <div class="field">
              {/* original uses a THIRD single-line input here, not a textarea */}
              <label for="message">Message</label>
              <input id="message" name="message" type="text" placeholder="Your message" />
            </div>
          </div>
          <button type="submit" class="cform__submit">
            <span class="btnswap">
              <span class="btnswap__rest">Submit</span>
              <span class="btnswap__hover" aria-hidden="true">Submit</span>
            </span>
          </button>
          <p class="cform__status" data-form-status role="status" aria-live="polite"></p>
        </form>

        <div class="contact__info">
          <h2 class="contact__title" data-reveal>Let&rsquo;s talk.</h2>
          <p class="contact__lead" data-reveal style="--reveal-delay:120ms">
            We&rsquo;re not just looking for ideas,<br />we&rsquo;re looking for great CEOs.
          </p>

          <hr class="contact__divider" />

          <div class="contact__cols">
            <div class="contact__col" data-reveal>
              <span class="contact__tag"><span class="contact__tag-arrow" aria-hidden="true">&#8627;</span>For Founders</span>
              <p>Submit your project for our review and potential investment.</p>
            </div>
            <div class="contact__col" data-reveal style="--reveal-delay:100ms">
              <span class="contact__tag"><span class="contact__tag-arrow" aria-hidden="true">&#8627;</span>For CEOs</span>
              <p>We&rsquo;re looking for exceptional CEOs. Lead a venture with us.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* submission handled by src/scripts/forms.ts (imported in Base.astro) */}

<style>
  .contact {
    background: var(--surface);
    /* original insets the panel just 6px from the viewport */
    padding: 0 6px clamp(40px, 6vw, 80px);
  }
  .contact__panel {
    position: relative;
    max-width: none;
    margin-inline: auto;
    border-radius: 25px;
    overflow: hidden;
    background: #191919;
    isolation: isolate;
    /* spec @1309: form card left edge x=54.7 → 48.7px in from the panel edge
       (panel starts at 6), which puts the card's 40px padding at label x=94.7.
       Vertical padding runs taller than spec by request — a bigger video frame
       with more dark breathing room around the content, like the live /contact. */
    padding: clamp(56px, 8.5vw, 118px) clamp(20px, 3.72vw, 48.7px);
  }
  /* spec: the video wrapper is filter:grayscale(1) + opacity:0.5 over the
     #191919 panel — that alone is the darkening, there is no gradient scrim */
  .contact__video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    opacity: 0.5;
    z-index: 0;
  }
  /* spec: a 5%-opacity grain texture, the panel's only overlay */
  .contact__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: url('/assets/images/rR6HYXBrMmX4cRpXfXUOvpvpB0.png');
    opacity: 0.05;
  }
  .contact__inner { position: relative; z-index: 2; padding: 0; }

  /* spec @1309: form card 388 wide at x=54.7; info column title at x=657, which
     the client nudges +28 to 685. 54.7 + 388 + 214.3 + 28 (info pad) = 685. */
  .contact__grid {
    display: grid;
    grid-template-columns: 388px 1fr;
    column-gap: clamp(40px, 16.37vw, 214.3px);
    row-gap: 40px;
    align-items: stretch;
  }

  /* form card — spec: 388x518.6, padding 40, radius 18, column gap 30 */
  .cform {
    background: #fff;
    border-radius: 18px;
    padding: 40px;
    display: grid;
    gap: 30px;
  }
  /* spec: an 87x24 frame with object-fit:contain; our source shares the
     original's 2.39 aspect, so the mark renders 57.4x24 centred, as it does live */
  .cform__logo { width: 87px; height: 24px; object-fit: contain; }
  .cform__fields { display: grid; gap: 16px; }
  .field { display: grid; gap: 12px; }
  .field label {
    font-family: var(--font-display-curved);
    font-size: 0.875rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: #090909;
  }
  /* spec: 58px box, padding 12px 12px 12px 16px, #f5f5f5, radius 10 */
  .field input {
    width: 100%;
    height: 58px;
    padding: 12px 12px 12px 16px;
    background: var(--surface);
    border: 1px solid transparent;
    border-radius: 10px;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--ink);
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .field input::placeholder { color: #999999; }
  .field input:focus { outline: none; border-color: var(--ink); background: #fff; }
  /* original: Marund 20px label at rest, Inter 600 slides in on hover (.btnswap) */
  .cform__submit {
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50px;
    background: var(--accent);
    color: #fff;
    transition: background 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  /* original: the pill goes BLACK on hover (photographed off the live site),
     it does not just brighten */
  .cform__submit:hover { background: #0a0a0a; }
  .cform__submit:disabled { opacity: 0.6; }
  .cform__status:empty { display: none; }
  .cform__status { font-size: 0.85rem; color: var(--ink); }
  .cform__status[data-state='error'] { color: #b3123f; }
  /* honeypot — off-screen for humans, still fillable by bots */
  .cform__botcheck {
    position: absolute;
    left: -9999px;
    width: 1px; height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* info */
  /* distribute the copy over the full panel height like the original:
     title + lead sit at the top, the divider + tags are anchored to the bottom */
  .contact__info {
    color: #fff;
    padding-block: 8px 4px;
    /* nudged well right of the spec position (657) by request */
    padding-left: 88px;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
  }
  .contact__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 3.875rem; /* Let's talk. — fixed 62px like the original */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: #fff;
  }
  .contact__lead {
    /* spec: the title block and the lead block are 94px apart */
    margin-top: 94px;
    font-family: var(--font-display-curved);
    font-size: clamp(1.4rem, 3.95vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .contact__divider {
    border: none;
    /* short and faint, per request — well inside the column, barely there */
    width: 460px;
    max-width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    /* spec: the lead → divider → tags stack is a 60px-gap flex column */
    margin: 60px 0;
  }
  /* col1 (For Founders) at title x=657; col2 (For CEOs) lands at ~940 (spec) */
  .contact__cols {
    display: grid;
    grid-template-columns: 283px 1fr;
    gap: 0;
  }
  /* spec: 31.2px tall row, 20px above the paragraph */
  .contact__tag {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    font-family: var(--font-display-curved);
    font-size: 1.625rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  /* spec: the ↳ arrow is a 25x25 icon with a 16px gap, so the label text
     starts exactly 41px into the column */
  .contact__tag-arrow {
    flex: 0 0 25px;
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    line-height: 1;
  }
  .contact__col p {
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.4;
    color: #fff;
    max-width: 22ch;
  }

  /* 810–1199 keeps the two-column desktop layout, but the desktop numbers
     (388px card + a 283px tag column + the 88px info inset) are wider than the
     panel there and pushed the page into horizontal scroll. Tighten the insets
     so it fits; below 810 the stacked layout takes over. */
  @media (min-width: 810px) and (max-width: 1199px) {
    .contact__grid { column-gap: 40px; }
    .contact__info { padding-left: 24px; }
    .contact__cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; }
    .contact__divider { width: 100%; }
  }

  /* Original phone: one centred 350px column; the COPY comes first ("Let's
     talk." → lead → tags), the white form card (350×516, padding 30) last */
  @media (max-width: 809px) {
    .contact__grid {
      display: flex;
      flex-direction: column;
      max-width: 350px;
      margin-inline: auto;
      row-gap: 40px;
    }
    .contact__info { order: -1; }
    .cform { padding: 30px; }
    .contact__cols { grid-template-columns: 1fr; gap: 28px; }
    /* original phone: the dark panel is FULL-BLEED (0..viewport), square-edged,
       content inset 20; "Let's talk." sits ~134px below the panel top */
    .contact { padding: 0; }
    .contact__panel { padding: 134px 20px 40px; border-radius: 0; }
    /* stacked: the desktop 60/60 rhythm is too airy in one narrow column */
    .contact__info { min-height: 0; padding-left: 0; }
    .contact__divider { margin: clamp(28px, 6vw, 40px) 0 clamp(24px, 3vw, 36px); }
    .contact__lead { margin-top: clamp(20px, 4vw, 32px); }
  }
  /* Skip the heavy background video on phones (saves ~30 MB); keep the dark panel + scrim. */
  @media (max-width: 640px) {
    .contact__video { display: none; }
    /* the scrim stands in for the video here, so it is opaque rather than grain */
    .contact__scrim {
      opacity: 1;
      background: linear-gradient(to bottom, #141414 0%, #0a0a0a 100%);
    }
  }
</style>
