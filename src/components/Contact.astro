---
import { FORM_ENDPOINT, FORM_KEY, FORM_PROVIDER, FORM_CONFIGURED } from '../config/form';
const video = '/assets/media/dOgk0Vxkcux0KWiIAWgeNGdfs.mp4';
---
<section class="contact" id="contact">
  <div class="contact__panel">
    <video class="contact__video" src={video} poster="/assets/images/vrhxHFTuxnCduP4nljUulqZcuQ.jpg" autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
    <div class="contact__scrim" aria-hidden="true"></div>

    <div class="container contact__inner">
      <div class="contact__grid">
        <form class="cform" action={FORM_ENDPOINT} method="post" data-contact-form data-provider={FORM_PROVIDER}>
          {FORM_CONFIGURED && <input type="hidden" name="access_key" value={FORM_KEY} />}
          <input type="checkbox" name="botcheck" class="cform__botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <img class="cform__logo" src="/assets/images/logo-v7.png" alt="V7" width="80" height="33" />
          <div class="field">
            <label for="name">Your name*</label>
            <input id="name" name="name" type="text" placeholder="John Doe" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">E-mail*</label>
            <input id="email" name="email" type="email" placeholder="hello@site.com" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="3" placeholder="Your message"></textarea>
          </div>
          <button type="submit" class="cform__submit">
            <span class="btnswap">
              <span class="btnswap__rest">Submit</span>
              <span class="btnswap__hover" aria-hidden="true">Submit</span>
            </span>
          </button>
          <p class="cform__status" data-form-status role="status" aria-live="polite"></p>
        </form>

        <div class="contact__info">
          <h2 class="contact__title" data-reveal>Let&rsquo;s talk.</h2>
          <p class="contact__lead" data-reveal style="--reveal-delay:120ms">
            We&rsquo;re not just looking for ideas,<br />we&rsquo;re looking for great CEOs.
          </p>

          <hr class="contact__divider" />

          <div class="contact__cols">
            <div class="contact__col" data-reveal>
              <span class="contact__tag"><span class="contact__tag-arrow" aria-hidden="true">&#8627;</span>For Founders</span>
              <p>Submit your project for our review and potential investment.</p>
            </div>
            <div class="contact__col" data-reveal style="--reveal-delay:100ms">
              <span class="contact__tag"><span class="contact__tag-arrow" aria-hidden="true">&#8627;</span>For CEOs</span>
              <p>We&rsquo;re looking for exceptional CEOs. Lead a venture with us.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* submission handled by src/scripts/forms.ts (imported in Base.astro) */}

<style>
  .contact {
    background: var(--surface);
    padding: 0 var(--gutter) clamp(40px, 6vw, 80px);
  }
  .contact__panel {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    border-radius: 40px;
    overflow: hidden;
    background: #0a0a0a;
    isolation: isolate;
    /* spec: form card sits ~25px from the panel edge (label x=95), so the
       horizontal padding is much tighter than the vertical */
    padding: clamp(40px, 6vw, 72px) clamp(20px, 1.95vw, 26px);
  }
  .contact__video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.72) contrast(1.02);
    z-index: 0;
  }
  .contact__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgba(10,10,10,0.88) 0%, rgba(10,10,10,0.32) 55%, rgba(10,10,10,0.5) 100%);
  }
  .contact__inner { position: relative; z-index: 2; padding: 0; }

  /* form (fixed ~374px, left) + info column starting at ~50% (title x=657 @1309).
     The wide gap is what places the info block at mid-panel like the original. */
  .contact__grid {
    display: grid;
    grid-template-columns: 374px 1fr;
    column-gap: clamp(40px, 17vw, 221px);
    row-gap: 40px;
    align-items: stretch;
  }

  /* form card */
  .cform {
    background: #fff;
    border-radius: 14px;
    padding: clamp(24px, 2.5vw, 34px);
    display: grid;
    gap: 18px;
  }
  .cform__logo { width: 80px; height: auto; margin-bottom: 6px; }
  .field { display: grid; gap: 8px; }
  .field label {
    font-family: var(--font-display-curved);
    font-size: 0.875rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: #090909;
  }
  .field input, .field textarea {
    width: 100%;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid transparent;
    border-radius: 10px;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--ink);
    resize: vertical;
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .field input::placeholder, .field textarea::placeholder { color: #999999; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--ink); background: #fff; }
  /* original: Marund 20px label at rest, Inter 600 slides in on hover (.btnswap) */
  .cform__submit {
    margin-top: 4px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50px;
    background: var(--accent);
    color: #fff;
    transition: filter 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .cform__submit:hover { filter: brightness(1.06); transform: translateY(-2px); }
  .cform__submit:disabled { opacity: 0.6; }
  .cform__status:empty { display: none; }
  .cform__status { font-size: 0.85rem; color: var(--ink); }
  .cform__status[data-state='error'] { color: #b3123f; }
  /* honeypot — off-screen for humans, still fillable by bots */
  .cform__botcheck {
    position: absolute;
    left: -9999px;
    width: 1px; height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* info */
  /* distribute the copy over the full panel height like the original:
     title + lead sit at the top, the divider + tags are anchored to the bottom */
  .contact__info {
    color: #fff;
    padding-block: 8px 4px;
    /* nudged right of the spec position (657) by request */
    padding-left: 28px;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
  }
  .contact__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: 3.875rem; /* Let's talk. — fixed 62px like the original */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: #fff;
  }
  .contact__lead {
    /* larger gap so the lead sits ~1/3 down the panel like the original */
    margin-top: clamp(40px, 6.6vw, 95px);
    font-family: var(--font-display-curved);
    font-size: clamp(1.4rem, 3.95vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #fff;
    opacity: 0.6; /* original renders this lead muted (measured live) */
  }
  .contact__divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    /* auto top margin pushes the divider + tags to the bottom of the panel */
    margin: auto 0 clamp(24px, 3vw, 36px);
  }
  /* col1 (For Founders) at title x=657; col2 (For CEOs) lands at ~940 (spec) */
  .contact__cols {
    display: grid;
    grid-template-columns: 283px 1fr;
    gap: 0;
  }
  .contact__tag {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-display-curved);
    font-size: 1.625rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  /* original: the ↳ arrow is its own element; label text starts ~40px after the
     column edge (arrow glyph + 13px gap) */
  .contact__tag-arrow { margin-right: 13px; }
  .contact__col p {
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.4;
    color: #fff;
    max-width: 22ch;
  }

  /* Original phone: one centred 350px column; the COPY comes first ("Let's
     talk." → lead → tags), the white form card (350×516, padding 30) last */
  @media (max-width: 809px) {
    .contact__grid {
      display: flex;
      flex-direction: column;
      max-width: 350px;
      margin-inline: auto;
      row-gap: 40px;
    }
    .contact__info { order: -1; }
    .cform { padding: 30px; }
    .contact__cols { grid-template-columns: 1fr; gap: 28px; }
    /* original phone: the dark panel is FULL-BLEED (0..viewport), square-edged,
       content inset 20; "Let's talk." sits ~134px below the panel top */
    .contact { padding: 0; }
    .contact__panel { padding: 134px 20px 40px; border-radius: 0; }
    /* stacked: no free space to distribute, so restore a normal divider gap */
    .contact__info { min-height: 0; padding-left: 0; }
    .contact__divider { margin-top: clamp(28px, 6vw, 40px); }
    .contact__lead { margin-top: clamp(20px, 4vw, 32px); }
  }
  /* Skip the heavy background video on phones (saves ~30 MB); keep the dark panel + scrim. */
  @media (max-width: 640px) {
    .contact__video { display: none; }
    .contact__scrim {
      background: linear-gradient(to bottom, #141414 0%, #0a0a0a 100%);
    }
  }
</style>
