---
const categories = ['SaaS', 'iGaming', 'Healthtech', 'Fintech', 'DeepTech'];
const grain = '/assets/images/grain.png';
---
<section class="inv" style={`--grain:url(${grain})`}>
  <div class="container">
    <div class="inv__grid">
      <span class="inv__eyebrow" data-reveal>
        <span class="inv__plus" aria-hidden="true">+</span>
        What we do
      </span>

      <div class="inv__main">
        <h2 class="inv__title" data-reveal>Investments.</h2>
        <p class="inv__lead" data-reveal style="--reveal-delay:120ms">
          Looking for teams with early revenue traction and unstoppable ambition.
        </p>
        <p class="inv__stage" data-reveal style="--reveal-delay:200ms">From Seed Stage to Series A</p>
        <a href="#contact" class="inv__cta" data-reveal style="--reveal-delay:280ms">Get started</a>
      </div>

      <div class="inv__cats" data-reveal style="--reveal-delay:160ms">
        <span class="inv__catsLabel">Categories</span>
        <ul class="inv__chips">
          {categories.map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Original: a rounded card, NOT full-bleed — 6px inset @desktop (6..1303,
     r25 all corners), fixed 386px wide centred on phone (x=175 @736, x=2 @390) */
  .inv {
    position: relative;
    background: #0a0a0a;
    color: #fff;
    margin-inline: 6px;
    border-radius: 25px;
    overflow: hidden;
    padding-block: clamp(64px, 8vw, 104px) clamp(80px, 12vw, 150px);
  }
  /* keep inner content at the same x as before the 6px inset (circle x=36) */
  @media (min-width: 810px) {
    .inv .container { padding-inline: 30px; }
  }
  @media (max-width: 809px) {
    .inv {
      width: min(386px, calc(100% - 4px));
      margin-inline: auto;
    }
  }
  .inv::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    background-repeat: repeat;
    opacity: 0.05;
    pointer-events: none;
    z-index: 0;
  }
  .inv .container { position: relative; z-index: 1; }

  /* Spec @1309: eyebrow x=63, main (title/lead) x=346, categories x=942.
     Fixed side tracks hit those columns; the middle track flexes with width. */
  .inv__grid {
    display: grid;
    grid-template-columns: 270px 1fr 331px;
    column-gap: 40px;
    align-items: start;
  }

  /* spec @1309: circle 18×18 at the gutter (x=36), gap 9 → label text at x=63 */
  .inv__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .inv__plus {
    display: inline-grid;
    place-items: center;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem; line-height: 1;
    font-family: var(--font-body);
  }

  .inv__main { display: flex; flex-direction: column; }
  .inv__title {
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(2rem, 7.65vw, 3.875rem); /* 62px on desktop (reaches cap ~810px), 32px on mobile — like original */
    line-height: 0.92;
    letter-spacing: -0.06em;
    color: #fff;
  }
  .inv__lead {
    margin-top: clamp(48px, 5.4vw, 78px);
    max-width: 300px;
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.95vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .inv__stage {
    margin-top: 22px;
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: #ffffff;
  }
  .inv__cta {
    align-self: flex-start;
    margin-top: clamp(48px, 6.6vw, 95px);
    padding: 18px 30px;
    border-radius: 50px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
    transition: transform 0.3s var(--ease-out), filter 0.3s var(--ease-out);
  }
  .inv__cta:hover { transform: translateY(-2px); filter: brightness(1.06); }

  .inv__cats { margin-top: clamp(60px, 9.4vw, 135px); }
  .inv__catsLabel {
    display: block;
    margin-bottom: 22px;
    font-family: var(--font-display-curved);
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: #ffffff;
  }
  /* chip box aligns with the "Categories" label; the chip's own 24px padding puts
     the text at x≈966 (spec) — no extra inset needed. Spec chip gap = 8px. */
  .inv__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    padding: 12px 24px;
    border-radius: 50px;
    background: #d9d9d9;
    color: #000;
    font-family: var(--font-display-curved);
    font-size: 1rem;
    line-height: 1;
    letter-spacing: -0.04em;
    transition: background 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .chip:hover { background: #fff; transform: translateY(-2px); }

  /* Original phone: one 334px column, centred (title x≈201 @736 / 28 @390);
     order = title, lead, stage, Categories+chips, THEN the centred CTA */
  @media (max-width: 900px) {
    .inv__grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
      max-width: 334px;
      margin-inline: auto;
    }
    .inv__main { display: contents; }
    .inv__title { font-size: 2rem; }
    .inv__lead { margin-top: 0; }
    .inv__cats { margin-top: 0; order: 1; }
    .inv__cta { margin-top: 0; order: 2; justify-self: center; align-self: center; }
  }
</style>
