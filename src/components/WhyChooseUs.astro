---
const photo = '/assets/images/JtJ7IX9ergJJBq7mkhSIaYElRM.png';
const stats = [
  { value: 4, suffix: '+years', label: 'Combined in venture' },
  { value: 10, suffix: '+', label: 'Deals closed' },
  { value: 3, suffix: 'M+', label: 'Invested' },
];
---
<section class="why">
  <div class="container">
    <div class="why__head">
      <span class="why__eyebrow" data-reveal>
        <span class="why__plus" aria-hidden="true">+</span>
        Why choose us
      </span>
      <h2 class="why__title" data-reveal style="--reveal-delay:80ms">
        <span class="why__ink">We fuel founders with funding, focus,</span>
        <span class="why__muted"> and firepower to reach their boldest goals.</span>
      </h2>
      <span class="why__underline" data-reveal style="--reveal-delay:260ms"></span>
    </div>

    <div class="why__body">
      <div class="why__photo" data-reveal>
        <img src={photo} alt="" width="404" height="500" loading="lazy" />
      </div>

      <div class="why__right">
        <p class="why__para" data-reveal>
          We don&rsquo;t just support founders. We breathe life into their ideas. With a proven
          track record, a battle-tested growth engine, and weekly co-creation sessions, we act
          like oxygen: always there, always essential.
        </p>

        <div class="why__stats" data-reveal-group="">
          {stats.map((s, i) => (
            <div class="stat" data-reveal-child style={`--reveal-delay:${i * 110}ms`}>
              <span class="stat__value">
                <span class="stat__num" data-count={s.value}>0</span><span class="stat__suffix">{s.suffix}</span>
              </span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--surface);
    padding-block: clamp(72px, 10vw, 140px);
  }

  /* head */
  .why__head { position: relative; }
  .why__eyebrow {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .why__plus {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    font-family: var(--font-body);
  }
  .why__title {
    margin-top: 0;
    margin-left: clamp(0px, 25%, 343px);
    max-width: 830px;
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(2.1rem, 4.17vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.06em;
  }
  .why__ink { color: #090909; }
  .why__muted { color: rgba(0, 0, 0, 0.6); }
  .why__underline {
    display: block;
    width: 230px;
    max-width: 40vw;
    height: 3px;
    background: var(--accent);
    margin-top: 28px;
    margin-left: clamp(0px, 25%, 343px);
  }

  /* body */
  .why__body {
    display: grid;
    grid-template-columns: minmax(280px, 404px) 1fr;
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(48px, 7vw, 96px);
    align-items: start;
  }
  .why__photo {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 404 / 500;
  }
  .why__photo img { width: 100%; height: 100%; object-fit: cover; }

  .why__right { display: flex; flex-direction: column; justify-content: space-between; height: 100%; gap: clamp(48px, 8vw, 120px); }
  .why__para {
    align-self: flex-end;
    max-width: 40ch;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .why__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .stat { display: flex; flex-direction: column; gap: 8px; }
  .stat__value {
    font-family: var(--font-display-curved);
    font-size: clamp(2rem, 3.06vw, 2.75rem);
    line-height: normal;
    letter-spacing: -0.07em;
    color: var(--accent);
  }
  .stat__label {
    font-family: var(--font-display-curved);
    font-size: 1.375rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .why__eyebrow { position: static; margin-bottom: 22px; }
    .why__title, .why__underline { margin-left: 0; }
    .why__body { grid-template-columns: 1fr; }
    .why__para { align-self: flex-start; }
    .why__stats { grid-template-columns: repeat(3, auto); justify-content: start; gap: 28px; }
  }
  @media (max-width: 420px) {
    .why__stats { grid-template-columns: 1fr 1fr; }
  }
</style>
