---
const photo = '/assets/images/JtJ7IX9ergJJBq7mkhSIaYElRM.png';
const stats = [
  { value: 4, suffix: '+years', label: 'Combined in venture' },
  { value: 10, suffix: '+', label: 'Deals closed' },
  { value: 3, suffix: 'M+', label: 'Invested' },
];
---
<section class="why">
  <div class="container">
    <div class="why__head">
      <span class="why__eyebrow" data-reveal>
        <span class="why__plus" aria-hidden="true">+</span>
        Why choose us
      </span>
      <h2 class="why__title" data-reveal style="--reveal-delay:80ms">
        <span class="why__ink">We fuel founders with funding, focus,</span>
        <span class="why__muted"> and firepower to reach their boldest goals.</span>
      </h2>
      <span class="why__underline" data-reveal style="--reveal-delay:260ms"></span>
    </div>

    <div class="why__body">
      <div class="why__photo" data-reveal>
        <img src={photo} alt="" width="404" height="500" loading="lazy" />
      </div>

      <div class="why__right">
        {/* the original indents the first line with 17 literal spaces (pre-wrap) */}
        <p class="why__para" data-reveal>{'                 '}We don&rsquo;t just support founders. We breathe life into their ideas. With a proven track record, a battle-tested growth engine, and weekly co-creation sessions, we act like oxygen: always there, always essential.</p>

        <div class="why__stats" data-reveal-group="">
          {stats.map((s, i) => (
            <div class="stat" data-reveal-child style={`--reveal-delay:${i * 110}ms`}>
              <span class="stat__value">
                <span class="stat__num" data-count={s.value}>0</span><span class="stat__suffix">{s.suffix}</span>
              </span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--surface);
    padding-block: clamp(72px, 10vw, 140px);
  }

  /* head */
  .why__head { position: relative; }
  /* spec @1309: circle 18×18 at x=36, gap 9 → label text starts at x=63 */
  .why__eyebrow {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .why__plus {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    line-height: 1;
    font-family: var(--font-body);
  }
  .why__title {
    margin-top: 0;
    margin-left: clamp(0px, 25%, 343px);
    max-width: 830px;
    font-family: var(--font-display-curved);
    font-weight: 400;
    font-size: clamp(2rem, 7.4vw, 3.75rem); /* 60px desktop (cap ~810px) → 32px mobile, like original */
    line-height: 1.1;
    letter-spacing: -0.06em;
  }
  .why__ink { color: #090909; }
  .why__muted { color: rgba(0, 0, 0, 0.6); }
  .why__underline {
    display: block;
    width: 230px;
    max-width: 40vw;
    height: 3px;
    background: var(--accent);
    margin-top: 28px;
    margin-left: clamp(0px, 25%, 343px);
  }

  /* body — original: photo left-aligned at the gutter (~404 wide), then the
     para+stats right block begins at ~50% of the container (para x≈655 @1309).
     So: two equal tracks, gap 0; the right track holds para (top) + stats (bottom). */
  .why__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: clamp(48px, 7vw, 96px);
    align-items: start;
  }
  .why__photo {
    width: 404px;
    max-width: 100%;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 404 / 500;
  }
  .why__photo img { width: 100%; height: 100%; object-fit: cover; }

  .why__right { display: flex; flex-direction: column; justify-content: space-between; height: 100%; gap: clamp(48px, 8vw, 120px); }
  .why__para {
    align-self: flex-start;
    max-width: 550px; /* spec: para block 550px wide @1309 */
    font-family: var(--font-display-curved);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--ink);
    white-space: pre-wrap; /* renders the 17 literal leading spaces, as the original */
  }
  /* stats: spec label columns start at x=696/920/1110 @1309 → fixed grid tracks
     (224px, 190px) from the 40px inset; NOT an even-gap flex row */
  /* original: the three stats sit in a white card (618.55×201, r18, padding 30) */
  .why__stats {
    display: grid;
    grid-template-columns: 224px 190px 1fr;
    align-content: center;
    min-height: 201px;
    padding: 30px 30px 30px 41px;
    background: #ffffff;
    border-radius: 18px;
  }
  .stat { display: flex; flex-direction: column; gap: 8px; }
  .stat__value {
    font-family: var(--font-display-curved);
    font-size: clamp(2rem, 5.43vw, 2.75rem);
    line-height: normal;
    letter-spacing: -0.07em;
    color: var(--accent);
  }
  .stat__label {
    opacity: 0.6; /* original dims the stat captions */
    max-width: 150px; /* spec: "Combined in venture" wraps to 2 lines (w=149) */
    font-family: var(--font-display-curved);
    font-size: 1.375rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  /* Original phone (<810): title 32px full-width; photo full-width at a FIXED
     603px height (697×603 @736, 351×603 @390); para stays 550 max; the stats
     stack vertically, anchored 122px from the VIEWPORT's right edge (x=474 @736,
     x=128 @390 — both = right anchor, container gutter 20 → margin-right 102). */
  @media (max-width: 809px) {
    /* reference @390: last card bottom 3593 → "Why choose us" 3633 = 40px.
       The Projects section already contributes 6px, so this adds 34. */
    .why { padding-block: 34px clamp(72px, 10vw, 140px); }
    .why__eyebrow { position: static; margin-bottom: 22px; }
    .why__title, .why__underline { margin-left: 0; }
    .why__title { font-size: 2rem; }
    .why__body { grid-template-columns: 1fr; }
    .why__photo { width: 100%; aspect-ratio: auto; height: 603px; }
    .why__para { align-self: flex-start; max-width: 550px; }
    .why__stats {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
      margin-left: 0;
      align-self: flex-end;
      margin-right: 102px;
    }
    .stat__label { max-width: 140px; } /* phone spec block = 140 wide */
  }
</style>
