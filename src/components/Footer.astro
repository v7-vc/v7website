---
// built-in year, so it can't go stale the way a hardcoded one does
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__main">
    <div class="container">
      <img class="footer__logo" src="/assets/images/logo-v7.png" alt="" width="561" height="114" />
    </div>
  </div>
  <div class="footer__bar">
    <div class="container">
      <span>&copy; {year} v7.vc. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--surface); }
  /* reference #698: padding 200px 36px 100px (the 36px is our container gutter);
     tablet/mobile #644: 50px 20px */
  .footer__main { padding-block: 50px; }
  /* reference #699: the footer block is a 2-column grid (gap 4px) and the logo
     sits in column 2, starting at x=656.5 @1309 */
  .footer__main .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  /* reference #706: img box 561x114 with object-fit contain. The artwork
     (aspect 2.392) letterboxes to 272.7x114 and sits flush against the box's
     RIGHT edge — measured in the original: box right 1283, artwork 1011..1282.
     Tablet/mobile #652: 330x73 at the gutter. */
  .footer__logo {
    grid-column: 2;
    width: 561px;
    max-width: 100%;
    height: 114px;
    object-fit: contain;
    object-position: right center;
  }
  .footer__bar {
    /* reference #708 */
    background: linear-gradient(90deg, #0a0a0a 0%, #050505 85%);
    color: #ffffff;
    padding-block: 42px;
  }
  @media (min-width: 810px) {
    .footer__main { padding-block: 200px 100px; }
  }
  .footer__bar span {
    font-family: var(--font-display-curved);
    font-size: 0.875rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
    opacity: 0.6; /* original renders the copyright muted */
  }
  /* Original phone: © sits in the centred 350 column, inset 16, at 16px */
  @media (max-width: 809px) {
    .footer__main .container { display: block; }
    .footer__logo { width: 330px; height: 73px; }
    .footer__bar .container {
      max-width: 350px;
      padding-inline: 16px;
    }
    .footer__bar span { font-size: 1rem; }
  }
</style>
